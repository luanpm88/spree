# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `$HOME/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files
.env*
# …but the templates carry no secrets and must be in the repo.
!.env.example
!.env.production.example
!.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files on local disk).
/storage/*
!/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore node_modules
/node_modules

# Ignore .ruby-lsp
.ruby-lsp/

# macOS
.DS_Store

# prebuilt assets
/app/assets/builds/*
!/app/assets/builds/.keep

coverage/*

# PDF build intermediate
docs/.user_guide.build.html

# ── Storefront (Next.js) ─────────────────────────────────────────────────────
# .pnpm-store is pnpm's content-addressable cache — tens of thousands of files
# that appeared here because pnpm ran with the repo as its store dir. Never commit.
storefront/.pnpm-store/
storefront/node_modules/
storefront/.next/
storefront/.env*
!storefront/.env.example
!storefront/.env.local.example
storefront/test-results/
storefront/playwright-report/

docs/.handover.build.html

# local deploy overrides (secrets)
deploy.env

# Project plan — the source of truth for where this engagement is.
# NOT committed: luanpm88/spree is a public repo and this file names the client's
# shop domains and the Spree versions each one runs. Publishing "these shops are
# on 5.2.3" is a roadmap for anyone looking for an unpatched target.
# Make the repo private if this needs version history.
# The glob matters. script/ac_sync writes docs/plan.json.bak before every change,
# and a bare `docs/plan.json` rule does not cover it. The .bak is a full copy of the
# same file: shop domains, server address, key paths. It sat untracked and would have
# gone in on the next `git add -A`, which is exactly how 67cda60 happened.
docs/plan.json*
docs/PLAN.md

# Client-owned email design assets. luanpm88/spree is a public repo; these are
# the client's templates and his brand copy, given to us to run HIS shops, not to
# publish. The mailer decorator checks for the view's presence rather than
# assuming it, so a checkout without them still sends correct stock emails.
app/views/spree/order_mailer/
the client's own locale files
app/views/spree/shipment_mailer/
app/views/spree/reimbursement_mailer/

# Client-branded PDF covers. Names a client, and this repo is public.
docs/.covers.local.json

# Client-owned shipping code. luanpm88/spree is public; these calculators were
# written for the client's business and their rates are commercially sensitive.
app/models/spree/calculator/shipping/
config/rural_postcodes.txt

# Names the client and quotes his messages. This repo is public.
docs/VOICE.md
