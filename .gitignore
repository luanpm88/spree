# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `$HOME/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files
.env*
# …but the templates carry no secrets and must be in the repo.
!.env.example
!.env.production.example
!.env.example
# The dashboard's build-time switches (no secrets: every VITE_ value is public).
# Without it the image would bake Spree's Enterprise previews back in.
!apps/dashboard/.env.production

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files on local disk).
/storage/*
!/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore node_modules
/node_modules

# Ignore .ruby-lsp
.ruby-lsp/

# macOS
.DS_Store

# prebuilt assets
/app/assets/builds/*
!/app/assets/builds/.keep

coverage/*

# PDF build intermediate
docs/.user_guide.build.html

# ── Storefront (Next.js) ─────────────────────────────────────────────────────
# .pnpm-store is pnpm's content-addressable cache — tens of thousands of files
# that appeared here because pnpm ran with the repo as its store dir. Never commit.
storefront/.pnpm-store/
storefront/node_modules/
storefront/.next/
storefront/.env*
!storefront/.env.example
!storefront/.env.local.example
storefront/test-results/
storefront/playwright-report/

docs/.handover.build.html

# local deploy overrides (secrets)
deploy.env

# Project plan — the source of truth for where this engagement is.
# NOT committed: luanpm88/spree is a public repo and this file names the client's
# shop domains and the Spree versions each one runs. Publishing "these shops are
# on 5.2.3" is a roadmap for anyone looking for an unpatched target.
# Make the repo private if this needs version history.
# The glob matters. script/ac_sync writes docs/plan.json.bak before every change,
# and a bare `docs/plan.json` rule does not cover it. The .bak is a full copy of the
# same file: shop domains, server address, key paths. It sat untracked and would have
# gone in on the next `git add -A`, which is exactly how 67cda60 happened.
docs/plan.json*
docs/PLAN.md

# Client-owned email design assets. luanpm88/spree is a public repo; these are
# The client's own email templates and brand copy, given to us to run THEIR shops, not
# to publish. This repository is public.
app/views/spree/order_mailer/

# Locale files. Inverted to an allowlist rather than a pattern that names the client's
# files, for two reasons. It keeps their brand out of a public repository, and it is
# strictly safer: a pattern has to be guessed in advance and one of theirs already
# slipped past an earlier attempt because an underscore is not a dot. Everything under
# config/locales is ignored unless it is one of ours, listed below, so a new file they
# send is protected the moment it lands.
config/locales/*
!config/locales/_email_key_defaults.en.yml
!config/locales/admin_branding.en.yml
!config/locales/admin_emails.en.yml
!config/locales/admin_invoice.en.yml
!config/locales/approval_workflow.en.yml
!config/locales/en.yml
!config/locales/signup_notification.en.yml
!config/locales/welcome_mailer.en.yml

# One file per shop, holding that shop's own email wording, taken from the shop's
# own live application. Entirely his copy, so the whole directory is ignored and
# there is no allowlist here to get wrong.
#
# It sits OUTSIDE config/locales deliberately, and the reason is worth keeping:
# Rails globs that directory as `**/*.{rb,yml}`, which is RECURSIVE. A
# subdirectory under it looked like isolation and was not — measured on the
# running container, config/locales/shops/au.en.yml was on the load path of every
# shop, including the ones it does not belong to. Two shops both write under
# plain "en", so that is not a tidiness problem, it is one shop sending another
# shop's wording. config/initializers/shop_locale.rb loads exactly one file from
# here, chosen by SHOP.
config/shop_locales/
# The three home page product rows per shop, as category permalinks. Gitignored
# for the same reason as the wording above it: the shop names in it are the
# client's brands, and this repository is public. check_no_client_data caught it
# the moment the sixth shop was added, because the first five are country codes
# and the sixth is a brand. Carried by CLIENT_ASSETS in script/commercial.
config/shop_collections
config/clean_url_shops

app/views/spree/shipment_mailer/
app/views/spree/reimbursement_mailer/
# Spree 6.0 sends the shipped email as FulfillmentMailer#fulfilled_email and the
# refund email as ReturnMailer#refunded_email; his Liquid ports live here.
app/views/spree/fulfillment_mailer/
app/views/spree/return_mailer/

# Client-branded PDF covers. Names a client, and this repo is public.
docs/.covers.local.json

# Client-owned shipping code. luanpm88/spree is public; these calculators were
# written for the client's business and their rates are commercially sensitive.
app/models/spree/calculator/shipping/
# And the autoload rule that exists ONLY to make those calculators resolve. One of
# them spells its acronym in a way Zeitwerk cannot derive from the filename, so
# without this the class is missing at runtime and that shop cannot quote shipping.
# Kept out of the public repo for the same reason as the calculators themselves; it
# reaches the server inside the build context, which is the directory, not the index.
config/initializers/inflections.rb

# Catalogue data that falls out of properties:export while migrating a shop. Each file
# is every product property of a real shop, product names and all.
db/*_properties.json
config/rural_postcodes.txt

# Names the client and quotes his messages. This repo is public.
docs/VOICE.md
# The cutover runbook. Names his shops, his domains and the order in which they
# move, same reason as PLAN.md above. Nearly went in as a tracked file: the check
# that said it was ignored was actually `git ls-files --error-unmatch`, which
# answers "is it tracked", not "is it ignored".
docs/CUTOVER.md
# Same reason: the migration runbook names shops, a domain, the Spree version each one
# runs, and quotes the client directly. The general engineering content lives in
# docs/DISCOVERIES.md 1.24, 1.25 and 2.16 instead, written so it identifies nobody.
docs/MIGRATION_RUNBOOK.md

# Everything the client sends us: dumps, templates, brand files, screenshots.
tmp/client/

# The scan pattern list. It names the client, so it stays out of a public repo.
.clientscan-patterns

# Names the client shops and domains. See .estate.example
.estate
.estate.env

# The client's own page copy. See content.example.ts
storefront/src/lib/blocks/content.ts

# His brand images: logo, favicons, the social card for each shop, the home page
# photographs. Same reason as the copy above, and the same delivery path — they
# are carried to the server by name in CLIENT_ASSETS, not by git.
storefront/public/brand/
# Rebuilt from his 260px icon, so /favicon.ico answers for the tools that ask for
# it by name instead of reading the link tag. His artwork, so not committed.
storefront/public/favicon.ico
.shopauth

# Every value the client has stated, per shop. His colours, his logo sizes, his
# words. Read by script/check_client_notes; the schema is in .client_notes.example.
.client_notes

# Python bytecode from the check scripts. Machine specific, and one got staged
# on 24 Aug when everything was staged at once to stop git checkout destroying
# unstaged work.
__pycache__/
*.pyc

# Which calculators each shop offers. Keys are shop names, so it cannot be
# tracked in a public repository; carried by CLIENT_ASSETS in script/commercial.
config/shop_calculators

# Per-shop template overrides. The path names the client shop, so it cannot be
# tracked in a public repository; carried by CLIENT_ASSETS in script/commercial.
app/views/shops/

# Retired page redirects. The paths and destinations are the client's own.
storefront/src/lib/blocks/retired-urls.json

# Backblaze B2 credentials the client pasted on the tracker. Rotate after use.
.b2.env
storefront/.env.business.local
docs/.risk_list.build.html
docs/.risk_network.build.html

# One deliverable address per shop, for the checkout probes. Gitignored because
# the rows are real addresses in the client's own countries.
#
# At the root, not under config/, and that is the point rather than a preference:
# check_deploy_assets reads anything gitignored under config/ as a file the
# running application will look for and not find, and it failed the run when
# this lived there. It is right to. Nothing on the server reads this, only the
# browser probes on this laptop, so it belongs beside .estate and .shopauth.
.checkout_probes

# Built beside the design PDF, for diffing a render. Regenerated every build.
docs/**/*.build.html
