# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `$HOME/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files
.env*
# …but the templates carry no secrets and must be in the repo.
!.env.example
!.env.production.example
!.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files on local disk).
/storage/*
!/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore node_modules
/node_modules

# Ignore .ruby-lsp
.ruby-lsp/

# macOS
.DS_Store

# prebuilt assets
/app/assets/builds/*
!/app/assets/builds/.keep

coverage/*

# PDF build intermediate
docs/.user_guide.build.html

# ── Storefront (Next.js) ─────────────────────────────────────────────────────
# .pnpm-store is pnpm's content-addressable cache — tens of thousands of files
# that appeared here because pnpm ran with the repo as its store dir. Never commit.
storefront/.pnpm-store/
storefront/node_modules/
storefront/.next/
storefront/.env*
!storefront/.env.example
!storefront/.env.local.example
storefront/test-results/
storefront/playwright-report/

docs/.handover.build.html

# local deploy overrides (secrets)
deploy.env

# Project plan — the source of truth for where this engagement is.
# NOT committed: luanpm88/spree is a public repo and this file names the client's
# shop domains and the Spree versions each one runs. Publishing "these shops are
# on 5.2.3" is a roadmap for anyone looking for an unpatched target.
# Make the repo private if this needs version history.
# The glob matters. script/ac_sync writes docs/plan.json.bak before every change,
# and a bare `docs/plan.json` rule does not cover it. The .bak is a full copy of the
# same file: shop domains, server address, key paths. It sat untracked and would have
# gone in on the next `git add -A`, which is exactly how 67cda60 happened.
docs/plan.json*
docs/PLAN.md

# Client-owned email design assets. luanpm88/spree is a public repo; these are
# The client's own email templates and brand copy, given to us to run THEIR shops, not
# to publish. This repository is public.
app/views/spree/order_mailer/

# Locale files. Inverted to an allowlist rather than a pattern that names the client's
# files, for two reasons. It keeps their brand out of a public repository, and it is
# strictly safer: a pattern has to be guessed in advance and one of theirs already
# slipped past an earlier attempt because an underscore is not a dot. Everything under
# config/locales is ignored unless it is one of ours, listed below, so a new file they
# send is protected the moment it lands.
config/locales/*
!config/locales/_email_key_defaults.en.yml
!config/locales/admin_branding.en.yml
!config/locales/admin_invoice.en.yml
!config/locales/approval_workflow.en.yml
!config/locales/en.yml
!config/locales/signup_notification.en.yml
!config/locales/welcome_mailer.en.yml
app/views/spree/shipment_mailer/
app/views/spree/reimbursement_mailer/

# Client-branded PDF covers. Names a client, and this repo is public.
docs/.covers.local.json

# Client-owned shipping code. luanpm88/spree is public; these calculators were
# written for the client's business and their rates are commercially sensitive.
app/models/spree/calculator/shipping/
# And the autoload rule that exists ONLY to make those calculators resolve. One of
# them spells its acronym in a way Zeitwerk cannot derive from the filename, so
# without this the class is missing at runtime and that shop cannot quote shipping.
# Kept out of the public repo for the same reason as the calculators themselves; it
# reaches the server inside the build context, which is the directory, not the index.
config/initializers/inflections.rb

# Dữ liệu catalogue của client rơi ra từ properties:export khi migrate từng shop.
# Mỗi file là toàn bộ product property của một shop thật, kèm tên sản phẩm.
db/*_properties.json
config/rural_postcodes.txt

# Names the client and quotes his messages. This repo is public.
docs/VOICE.md
# Cùng lý do: runbook migrate gọi thẳng tên shop, domain, phiên bản Spree từng shop,
# trích nguyên lời client và ghi ngày chốt. Nội dung kỹ thuật chung đã tách sang
# docs/DISCOVERIES.md §1.24, §1.25, §2.16 dưới dạng trung tính, không định danh ai.
docs/MIGRATION_RUNBOOK.md

# Everything the client sends us: dumps, templates, brand files, screenshots.
tmp/client/
