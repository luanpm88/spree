# Read by `vite build` (the image's dashboard stage). No credentials here: every
# VITE_ value is compiled into the bundle.
#
# No Spree Enterprise preview pages or notes in this shop's dashboard. He asked
# for the Enterprise notice to be blocked on 5.6 (tracker task 8, 13 Aug) and it
# was; the 6.0 dashboard brings its own, and this is its documented switch.
VITE_SPREE_ENTERPRISE_PREVIEWS=false
