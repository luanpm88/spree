# Copy to .env ON THE SERVER and fill in. Never commit the real .env.
#   cp .env.production.example .env && nano .env
#
# Generate secrets with:  openssl rand -hex 64   /   openssl rand -base64 24

# ── Required ────────────────────────────────────────────────────────────────
# 64-byte hex. Changing this invalidates all sessions and breaks any encrypted
# column — set it once and keep it.
SECRET_KEY_BASE=CHANGE_ME

# Public hostname, host only (no https://, no trailing slash). Used for EVERY
# generated URL: image URLs in API responses, links inside emails.
RAILS_HOST=spree.b-teka.com

# HTTP Basic auth for the /jobs dashboard. Required in production.
MISSION_CONTROL_USER=jobs
MISSION_CONTROL_PASSWORD=CHANGE_ME

# ── Image ───────────────────────────────────────────────────────────────────
# Pin to a specific commit for a reproducible deploy / instant rollback:
#   SPREE_IMAGE=ghcr.io/luanpm88/spree:sha-<40-char-commit>
SPREE_IMAGE=ghcr.io/luanpm88/spree:latest

# Loopback port nginx proxies to. Must match deploy/nginx/*.conf.
SPREE_PORT=3010

# ── Memory budget ───────────────────────────────────────────────────────────
# Upstream states one Spree process needs ~1GB RAM. Keep these at 1/3/2 on a
# small box; raise only with real headroom.
WEB_CONCURRENCY=1
RAILS_MAX_THREADS=3
JOB_THREADS=2
RAILS_LOG_LEVEL=info

# ── Email — REQUIRED for a working store ────────────────────────────────────
# With SMTP_HOST unset, Spree only writes mail to the log. Customers receive
# NOTHING: no order confirmation, no password reset, no admin invite.
# Verify after deploy:
#   docker compose -f docker-compose.prod.yml exec web \
#     bin/rails runner script/smoke_mail.rb you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=store@b-teka.com

# ── Optional ────────────────────────────────────────────────────────────────
# Object storage for uploads. Without it, files live in the storage_data volume
# — fine for one server, but back it up (docs/DEPLOY.md §8).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-1
# AWS_BUCKET=

# Meilisearch (typo-tolerant product search). Costs ~100MB RAM — skip on a
# small box; database search is the default.
# MEILISEARCH_URL=
# MEILISEARCH_API_KEY=

# Error tracking
# SENTRY_DSN=
