#!/usr/bin/env bash
#
# Refuse to let anything that identifies the client into a public repository.
#
#   script/check_no_client_data              everything git tracks
#   script/check_no_client_data --staged     only what is about to be committed
#
# ── why this is a gate and not a report ──────────────────────────────────────
#
# It printed a warning once and the commit went in underneath it, because a warning
# needs someone to be reading. Two of the leaks it now catches got in exactly that way:
# a client's shop name in a usage example, and a path with their name in it. Both were
# found later by a wider scan than the one that had passed.
#
# So this exits non-zero. Wired to .githooks/pre-commit, so the commit does not happen.
#
# ── what counts ──────────────────────────────────────────────────────────────
#
# Not only credentials. A first name plus a brand identifies a client as surely as a
# domain does, and this repository is public. The patterns live in one place below so
# adding a new client means adding a line, not remembering nine places.
#
# To allow a specific line, put it in .clientscanignore, one grep-compatible pattern
# per line. Keep it short: every entry is a thing this cannot protect.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

STAGED=0
[ "${1:-}" = "--staged" ] && STAGED=1

# The patterns live OUTSIDE the repository, in .clientscan-patterns, which is
# gitignored. Keeping them here would publish the client's name in the file whose job
# is to keep it out, and the hook proved that by refusing its own commit. One
# grep-compatible pattern per line, blank lines and # comments ignored.
PATTERN_FILE='.clientscan-patterns'
if [ ! -f "$PATTERN_FILE" ]; then
  cat >&2 <<'NOPE'
no .clientscan-patterns in this checkout, so nothing is being checked.

Copy .clientscan-patterns.example to .clientscan-patterns and put the names, brands
and domains this repository must never contain in it, one per line. It is gitignored
on purpose: the list itself identifies the client.
NOPE
  exit 1
fi
PATTERNS=$(grep -vE '^\s*(#|$)' "$PATTERN_FILE" | paste -sd'|' -)
[ -n "$PATTERNS" ] || { echo ".clientscan-patterns is empty, nothing to check" >&2; exit 1; }

IGNORE_FILE='.clientscanignore'
filter() {
  if [ -f "$IGNORE_FILE" ]; then grep -vEf "$IGNORE_FILE"; else cat; fi
}

if [ "$STAGED" = "1" ]; then
  FILES=$(git diff --cached --name-only --diff-filter=ACM)
  read_file() { git show ":$1" 2>/dev/null; }
  WHAT="staged for commit"
else
  # Tracked files AND files that are new but not ignored.
  #
  # `git ls-files` alone reads only what git already knows about, so a file
  # written five minutes ago and about to be committed is invisible to this
  # check. That is precisely the moment the check exists for: a new rake task
  # went past clean while carrying the client's product slugs in its comments,
  # because it had not been `git add`ed yet.
  #
  # --others --exclude-standard adds the untracked files that are not gitignored,
  # which is the set that would go in on the next `git add -A`.
  FILES=$( { git ls-files; git ls-files --others --exclude-standard; } | sort -u )
  read_file() { cat "$1" 2>/dev/null; }
  WHAT="tracked or about to be"
fi

[ -z "$FILES" ] && { echo "nothing $WHAT"; exit 0; }

# ── the second pass: shapes, not names ───────────────────────────────────────
#
# The list above can only hold what is known in advance: the client's brands, his
# domains, his product names. It cannot hold his CUSTOMERS, because nobody knows
# their names until one of them places an order.
#
# That gap was found the hard way, twice in two days. Both times a real customer's
# name, email address and street went into a comment while writing up what had
# been measured, and this check passed, because a customer is not on the list and
# never could be.
#
# So these patterns match by shape and name nobody:
#
#   an order number    three capitals then nine digits, which is his format
#   an email address   any real one, minus the placeholder domains below
#
# Case sensitive on purpose. Matched case-insensitively, a sha256 in Gemfile.lock
# contains "eca4752..." and reads as an order number.
SHAPES='\b[A-Z]{3}[0-9]{9}\b|\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b'

# Addresses that are examples, machinery, or ours. Anything else in a public file
# is somebody's real address and does not belong here.
#
# The placeholder list is deliberately multilingual. The first run of this pass
# flagged the German, Spanish, French and Polish sign-up forms, because every
# translator wrote "example" in their own language and only the English one was
# allowed for. A gate that cries wolf on four translation files gets switched off.
SHAPE_SAFE='@(example|test|invalid|localhost|127\.0\.0\.1)'
SHAPE_SAFE="$SHAPE_SAFE"'|@(beispiel|ejemplo|exemple|przyklad|esempio|voorbeeld)\.'
SHAPE_SAFE="$SHAPE_SAFE"'|@(domain|email|company|your-domain|mydomain|shop)\.(com|net|org)'
SHAPE_SAFE="$SHAPE_SAFE"'|@[a-z0-9.-]*(spreecommerce|getvendo|rubygems|github|anthropic|nodejs|npmjs|sentry\.io)'
SHAPE_SAFE="$SHAPE_SAFE"'|noreply@|no-reply@|postmaster@|your-?email@|user@|admin@example'
SHAPE_SAFE="$SHAPE_SAFE"'|@sha256|@types/|@spree/|@playwright/|@tailwindcss/|@biomejs/'
# Our own company, and the demo domain of an unrelated project already in this
# tree. Neither is the client and neither is a customer of his.
SHAPE_SAFE="$SHAPE_SAFE"'|@hoangkhang\.com\.vn|@b-teka\.com'

# Dependency locks and checksums, where a shape match is never a person, and
# binaries, where matching bytes mean nothing. A PDF flagged on its own
# compressed streams was the first false red this pass produced.
SHAPE_SKIP_FILE='^(Gemfile\.lock|.*/?package-lock\.json|.*/?pnpm-lock\.yaml|yarn\.lock|.*\.sum)$|\.(pdf|png|jpe?g|webp|gif|ico|woff2?|ttf|zip|gz|mp4|webm|db|sqlite3?)$'

hits=0
count=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  count=$((count + 1))
  found=$(read_file "$f" | grep -inE "$PATTERNS" | filter | head -3)

  if ! printf '%s' "$f" | grep -qE "$SHAPE_SKIP_FILE"; then
    shaped=$(read_file "$f" | grep -nE "$SHAPES" | grep -vE "$SHAPE_SAFE" | filter | head -3)
    if [ -n "$shaped" ]; then
      found=$(printf '%s\n%s' "$found" "$shaped" | grep -v '^$')
    fi
  fi

  if [ -n "$found" ]; then
    hits=$((hits + 1))
    printf '\n  %s\n' "$f"
    printf '%s\n' "$found" | sed 's/^/      /' | cut -c1-140
  fi
done <<< "$FILES"

echo ''
if [ "$hits" -eq 0 ]; then
  echo "ok — $count files $WHAT, nothing identifying the client"
  exit 0
fi

cat <<MSG
$hits file(s) name the client, and this repository is public.

Fix the wording, or move the file out of the tree and add it to .gitignore. If a
line is genuinely fine, add a pattern to .clientscanignore and say why in a comment.
MSG
exit 1
