#!/usr/bin/env python3
"""The per-shop themes in globals.css say what they mean.

Three faults, all of them from one afternoon, all of them silent.

1. A theme block that redefines --color-gray-200 and friends. It reads like the
   fix and it reaches nothing: @theme in this file is declared `inline`, which
   substitutes each value into the utilities at build time instead of emitting
   var(--color-gray-200), so a class carries the hex literally. Proven rather
   than assumed: under [data-theme="black"] the variable read #d7d7d7 while a
   .border-gray-200 element rendered rgb(229,232,217). Two builds went out
   believing that block worked.

2. A malformed rule body, `{{...}}` instead of `{...}`. 88 of them shipped,
   generated by a script whose f-string collapsed the braces. Every one is
   invalid CSS, every one was dropped by the parser, and the measurement
   afterwards came back BYTE IDENTICAL to the measurement before, which is what
   made it look like a deeper problem than a typo.

3. A theme that sets tokens and no utilities, or utilities and no tokens.
   Components read both. The first pass here set only tokens and closed 8 of the
   client's 10 items, which reads as "nearly there" and was in fact a mechanism
   that could never close the other 2.

Read only. Exits 1 on a finding.
"""

import re
import sys
from pathlib import Path

CSS = Path(__file__).resolve().parent.parent / "storefront/src/app/globals.css"

# Where the generated utility overrides start. Everything above it is hand
# written, everything below is generated from the utilities actually used.
GENERATED_MARK = "Utility overrides, because @theme is declared inline"


def theme_blocks(text):
    """Each [data-theme="x"] { ... } block, by name, top level only."""
    out = {}
    for m in re.finditer(r'\[data-theme="([^"]+)"\]\s*\{', text):
        name = m.group(1)
        # A selector with a descendant is a utility override, not a token block.
        if text[m.start() : m.end()].count(" ") > 1:
            continue
        depth, i = 1, m.end()
        while i < len(text) and depth:
            if text[i] == "{":
                depth += 1
            elif text[i] == "}":
                depth -= 1
            i += 1
        out.setdefault(name, []).append(text[m.end() : i - 1])
    return out


def main():
    if not CSS.exists():
        print(f"    {CSS} is missing")
        return 1

    raw = CSS.read_text()

    # Comments out first. This file documents itself heavily, and the header of
    # the generated block explains the specificity bug by quoting the selector
    # `[data-theme="x"] .text-gray-900`. The scan below read that prose as CSS and
    # reported a theme called "x" with utilities and no tokens.
    #
    # A gate that reads its own explanation as input will always eventually
    # accuse the explanation. Analyse code, never prose.
    text = re.sub(r"/\*.*?\*/", "", raw, flags=re.S)
    findings = []

    # 1. Inert colour-scale overrides inside a theme block.
    for name, blocks in theme_blocks(text).items():
        for body in blocks:
            for m in re.finditer(r"--color-([a-z]+)-(\d+)\s*:", body):
                findings.append(
                    f'[data-theme="{name}"] redefines --color-{m.group(1)}-{m.group(2)}.\n'
                    "      @theme is declared inline in this file, so that value was already\n"
                    "      substituted into every utility at build time and this reaches none\n"
                    "      of them. Override the utilities themselves instead, below the\n"
                    f'      "{GENERATED_MARK}" marker.'
                )

    # 2. Malformed rule bodies.
    #
    # Only the OPENING pair. `}}` is legitimate the moment anything nests: a rule
    # inside a media query closes with two braces, and this check flagged 37 of
    # them the first time a hover variant was generated. The bug it exists for
    # always has the opening pair, because it comes from a template that emitted
    # `.cls{{prop:val}}`, and valid CSS never has `{{` adjacent: there is always a
    # selector or an at-rule between one brace and the next.
    for m in re.finditer(r"\{\{", text):
        line = text[: m.start()].count("\n") + 1
        findings.append(
            f"line {line}: a doubled brace, {m.group(0)!r}.\n"
            "      That is not valid CSS and the parser drops the whole declaration,\n"
            "      silently. 88 of these shipped once and the measurement afterwards was\n"
            "      identical to the one before, which is how they went unnoticed."
        )

    # 3. A theme with tokens but no utilities, or the other way round.
    named = set(re.findall(r'\[data-theme="([^"]+)"\]', text))
    for name in sorted(named):
        has_tokens = bool(theme_blocks(text).get(name))
        has_utilities = bool(
            re.search(r'\[data-theme="' + re.escape(name) + r'"\]\s+\.', text)
        )
        if has_tokens and not has_utilities:
            findings.append(
                f'[data-theme="{name}"] sets tokens and overrides no utilities.\n'
                "      Components read both. A theme that only sets tokens repaints the\n"
                "      parts that read var(--...) and leaves every gray-, slate- and\n"
                "      primary- utility on the other shop's palette."
            )
        if has_utilities and not has_tokens:
            findings.append(
                f'[data-theme="{name}"] overrides utilities and sets no tokens.\n'
                "      The other half of the same fault."
            )

    if findings:
        print(f"      {len(findings)} finding(s) in globals.css\n")
        for f in findings[:12]:
            print(f"      {f}\n")
        if len(findings) > 12:
            print(f"      ... and {len(findings) - 12} more")
        return 1

    themes = sorted(named)
    print(
        f"      ok — {len(themes)} theme(s) ({', '.join(themes)}), "
        "tokens and utilities both present, no inert scale overrides"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
