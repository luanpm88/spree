#!/usr/bin/env bash
#
# Two databases, row by row. What was in the first and is not in the second.
#
#   script/reconcile_shop <before_db> <after_db>
#   script/reconcile_shop nz_prev nz_shop
#
# ── the failure this exists for ──────────────────────────────────────────────
#
# On 30 Aug a shop was reloaded from a fresh dump of the client's server to
# recover 19 orders that had been placed after the dump the cutover used. The
# reload is a restore, so it replaces everything, and the question that follows
# is not "did the orders arrive" but "did anything else leave".
#
# Row counts were compared first and they were not enough, twice over:
#
#   spree_products_taxons  794 -> 791.  Read as three lost categories. Diffing by
#                          product NAME then produced three names, two of which
#                          were the same products under new names the client had
#                          given them on his own server. Diffing by SKU showed the
#                          real shape: 39 assignments gained, 3 lost.
#
#   A count cannot see a swap. A table that loses four rows and gains four looks
#   untouched, and the four that left are gone regardless.
#
# So this compares identity, not quantity, for every table in the database.
#
# ── what it uses as identity ─────────────────────────────────────────────────
#
# A table with an `id` is compared by id. Ids survive a dump and restore, so a
# row that kept its id is the same row.
#
# A join table has no id, and its whole row IS its identity, so those are
# compared by a hash of the row. That covers spree_products_taxons, which is the
# table that started this.
#
# ── what it deliberately says nothing about ──────────────────────────────────
#
# A row present on both sides whose CONTENTS changed. The client edits his shop
# every day: renames, reprices, rewrites descriptions. Reporting those as
# differences would bury the one finding that matters under a hundred that are
# his own work. Contents are checked separately, per table, where there is a rule
# about what the contents should be.
set -uo pipefail
cd "$(dirname "$0")/.."

BEFORE="${1:-}"
AFTER="${2:-}"
if [[ -z "$BEFORE" || -z "$AFTER" ]]; then
  echo "usage: script/reconcile_shop <before_db> <after_db>" >&2
  exit 2
fi

# shellcheck source=/dev/null
[[ -f .estate.env ]] && source .estate.env

: "${SSH_HOST:?no SSH_HOST, source .estate.env}"
: "${SSH_PORT:=22}"
: "${SSH_KEY:?no SSH_KEY}"

if [[ -t 1 ]]; then GR=$'\033[32m'; RE=$'\033[31m'; YE=$'\033[33m'; R=$'\033[0m'
else GR=''; RE=''; YE=''; R=''; fi

WORK="${TMPDIR:-/tmp}/reconcile.$$"
mkdir -p "$WORK"
trap 'rm -rf "$WORK"' EXIT

remote() { ssh -n -i "$SSH_KEY" -p "$SSH_PORT" -o BatchMode=yes "$SSH_HOST" "$@"; }

# Tables whose rows are generated by the machine rather than entered by a person.
# A difference here is not a finding: the cache is rebuilt, the queue drains, the
# session expires. Listing them by name rather than by pattern, so a new table
# has to be considered rather than silently skipped.
TRANSIENT='^(solid_cache_entries|solid_queue_.*|solid_cable_messages|spree_payment_sessions|active_storage_variant_records|sessions|spree_preferences)$'

echo "  reconciling ${BEFORE} -> ${AFTER} on ${SSH_HOST}"
echo

# One query per database rather than one per table. 174 tables over ssh is 348
# round trips; this is 2.
keyset_sql() {
  cat <<'SQL'
SELECT string_agg(q, ' UNION ALL ') FROM (
  SELECT CASE
    WHEN EXISTS (SELECT 1 FROM information_schema.columns c
                 WHERE c.table_schema='public' AND c.table_name=t.tablename AND c.column_name='id')
    THEN format('SELECT %L::text AS t, id::text AS k FROM %I', t.tablename, t.tablename)
    ELSE format('SELECT %L::text AS t, md5(x.*::text) AS k FROM %I x', t.tablename, t.tablename)
  END AS q
  FROM pg_tables t
  WHERE t.schemaname='public'
    AND t.tablename NOT LIKE 'ar_internal%'
    AND t.tablename NOT LIKE 'schema_migrations%'
) s
SQL
}

for db in "$BEFORE" "$AFTER"; do
  printf '  reading %s ... ' "$db"
  sql=$(remote "docker exec estate-postgres psql -U postgres -At -d $db -c \"$(keyset_sql | tr '\n' ' ')\"" 2>/dev/null | tr -d '\r')
  if [[ -z "$sql" ]]; then
    echo "${RE}could not build the key query${R}"
    exit 1
  fi
  # The generated query is large. Hand it over on stdin rather than as an
  # argument, which -n forbids, so this one call opens its own connection.
  printf '%s\n' "$sql" \
    | ssh -i "$SSH_KEY" -p "$SSH_PORT" -o BatchMode=yes "$SSH_HOST" \
        "cat > /tmp/reconcile_keys.sql && docker exec -i estate-postgres psql -U postgres -At -F'|' -d $db -f /dev/stdin < /tmp/reconcile_keys.sql" \
        2>/dev/null | tr -d '\r' | grep -E '^[a-z_0-9]+\|' | sort > "$WORK/$db.keys"
  echo "$(wc -l < "$WORK/$db.keys" | tr -d ' ') rows"
done

echo
comm -23 "$WORK/$BEFORE.keys" "$WORK/$AFTER.keys" > "$WORK/lost"
comm -13 "$WORK/$BEFORE.keys" "$WORK/$AFTER.keys" > "$WORK/gained"

lost_real=0
python3 - "$WORK/lost" "$WORK/gained" "$TRANSIENT" <<'PY'
import re, sys, collections
lost_f, gained_f, transient = sys.argv[1], sys.argv[2], sys.argv[3]
tr = re.compile(transient)

def tally(path):
    c = collections.Counter()
    for line in open(path):
        line = line.strip()
        if '|' in line:
            c[line.split('|', 1)[0]] += 1
    return c

lost, gained = tally(lost_f), tally(gained_f)
real = {t: n for t, n in lost.items() if not tr.match(t)}
skipped = {t: n for t, n in lost.items() if tr.match(t)}

print("  ROWS THAT LEFT (present before, absent after)")
if not real:
    print("    none, outside the machine-generated tables")
for t, n in sorted(real.items(), key=lambda kv: -kv[1]):
    print(f"    {t:<42} {n:>6}   (gained {gained.get(t, 0)})")

if skipped:
    print()
    print("  machine-generated, not counted:")
    for t, n in sorted(skipped.items(), key=lambda kv: -kv[1]):
        print(f"    {t:<42} {n:>6}")

print()
print("  ROWS THAT ARRIVED (absent before, present after)")
arrived = {t: n for t, n in gained.items() if not tr.match(t)}
for t, n in sorted(arrived.items(), key=lambda kv: -kv[1])[:20]:
    print(f"    {t:<42} {n:>6}")
if len(arrived) > 20:
    print(f"    ... and {len(arrived) - 20} more table(s)")

open('/tmp/reconcile_verdict', 'w').write(str(sum(real.values())))
PY

lost_real=$(cat /tmp/reconcile_verdict 2>/dev/null || echo 0)
rm -f /tmp/reconcile_verdict

echo
echo "  the rows that left, in full:"
grep -vE "^($(echo "$TRANSIENT" | sed 's/^\^(//; s/)\$$//'))\|" "$WORK/lost" \
  | head -200 | sed 's/^/    /'
lost_lines=$(grep -cvE "^($(echo "$TRANSIENT" | sed 's/^\^(//; s/)\$$//'))\|" "$WORK/lost" || true)
[[ "${lost_lines:-0}" -gt 200 ]] && echo "    ... and $((lost_lines - 200)) more"

echo
if [[ "${lost_real:-0}" -gt 0 ]]; then
  echo "  ${YE}${lost_real} row(s) left.${R} Each one needs a reason before this is called safe."
  echo "  A row of the client's that left with no reason is data loss and must be put back."
  exit 1
fi
echo "  ${GR}ok${R} — nothing of the client's left the database"
