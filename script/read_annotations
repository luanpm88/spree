#!/usr/bin/env bash
#
# Read the client's annotated screenshots.
#
#   script/read_annotations "shot.png"              one image, every line with its position
#   script/read_annotations --notes "shot.png"      only the lines that look like his notes
#   script/read_annotations --zoom "shot.png"       the same, tile by tile at 2x
#   script/read_annotations "dir"                   every image in a directory
#
# ── why a wrapper ────────────────────────────────────────────────────────────
#
# The reader itself is Swift against macOS Vision (script/read_annotations.swift).
# This compiles it on demand into a cache, so the tool survives a session ending
# and there is nothing to install.
#
# ── why --zoom exists ────────────────────────────────────────────────────────
#
# A full page screenshot is tall, Vision downsamples it, and small handwriting in
# a margin can be dropped. Tiling at 2x catches those. Run both and take the
# union: on 17 Aug the full pass and the zoom pass each found a note the other
# missed, and the notes were the specification.
#
# ── the part a person still has to do ────────────────────────────────────────
#
# This reads words, not arrows. Which element a note points at is inferred from
# its coordinates, so print the coordinate alongside the reading and have the
# client confirm the mapping. Three notes were acted on correctly and one was
# guessed; the guess is the one worth checking.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

SRC="script/read_annotations.swift"
BIN="${TMPDIR:-/tmp}/read_annotations.$(md5 -q "$SRC" 2>/dev/null || md5sum "$SRC" | cut -c1-8)"

build() {
  [ -x "$BIN" ] && return 0
  command -v swiftc >/dev/null || { echo "swiftc not found. This tool needs macOS."; exit 2; }
  swiftc -O "$SRC" -o "$BIN" 2>/dev/null || { echo "could not build $SRC"; exit 2; }
}

# The phrases he actually writes. Deliberately his vocabulary rather than a
# general "looks like a note" guess, because a wrong filter hides a requirement.
NOTE_RE='wrong|need|no space|flip|caps|round|colou?r|bigger|black|gray|grey|check all|bold|will work|below the line|font|same in|logo|link'

MODE="all"
case "${1:-}" in
  --notes) MODE="notes"; shift ;;
  --zoom)  MODE="zoom";  shift ;;
esac

TARGET="${1:-}"
[ -n "$TARGET" ] || { sed -n '3,10p' "$0" | sed 's/^# //; s/^#//'; exit 2; }

build

read_one() {
  local f="$1"
  echo "════ $(basename "$f")"
  case "$MODE" in
    all)   "$BIN" "$f" ;;
    notes) "$BIN" "$f" | grep -Ei "$NOTE_RE" || echo "  (no note-like text found)" ;;
    zoom)
      python3 - "$f" "$BIN" "$NOTE_RE" <<'PY'
import subprocess, sys, tempfile, os, re
from PIL import Image
path, binary, note_re = sys.argv[1], sys.argv[2], sys.argv[3]
im = Image.open(path); w, h = im.size
rx = re.compile(note_re, re.I)
found = set()
with tempfile.TemporaryDirectory() as tmp:
    for gx in range(3):
        for gy in range(3):
            box = (int(w*gx/3), int(h*gy/3), int(w*(gx+1)/3), int(h*(gy+1)/3))
            tile = im.crop(box).resize(((box[2]-box[0])*2, (box[3]-box[1])*2), Image.LANCZOS)
            p = os.path.join(tmp, f"{gx}{gy}.png"); tile.save(p)
            out = subprocess.run([binary, p], capture_output=True, text=True).stdout
            for line in out.splitlines()[1:]:
                text = line.split("  ", 1)[-1].strip()
                if text and rx.search(text) and len(text) < 70:
                    found.add(text)
for t in sorted(found):
    print(f"  {t}")
PY
      ;;
  esac
  echo
}

if [ -d "$TARGET" ]; then
  # A loop with `< /dev/null` on the body: without it a command inside that reads
  # stdin swallows the rest of the file list and the loop runs once.
  find "$TARGET" -maxdepth 1 \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) \
    | sort | while IFS= read -r f; do read_one "$f" < /dev/null; done
else
  read_one "$TARGET"
fi
