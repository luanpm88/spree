#!/usr/bin/env node
// Post a comment to an ActiveCollab task, from a file, after showing it to you.
//
//   script/ac_comment 1 draft.md           preview only, sends nothing
//   script/ac_comment 1 draft.md --send    actually post it
//   script/ac_comment 1 draft.md --as huy --env .env.ac_huy --send
//                                          --as names who must be posting; the token's own user is
//                                          checked against it and nothing is sent on a mismatch
//   … --off-assignment                    post on a task the poster is not assigned to (e.g.
//                                          Luan answering a question put to him on Huy's task);
//                                          refused without it
//   script/ac_comment 1 draft.md --send --attach report.pdf
//                                          attach a file (repeat --attach for more)
//   … --hold-if-new-since <unix time>      exit 3 and send nothing when someone else has commented on
//                                          the task since then (script/ac_queue passes the time it
//                                          queued the reply)
//   script/ac_comment 1 draft.md --env .env.ac_team --project 2
//                                          another site and project (default
//                                          .env.activecollab, project 264). The client
//                                          moved his information to the team site on
//                                          4 Nov, and this only knew the old one
//
// Without --send this is a dry run. That is deliberate and not negotiable in the
// flags: this writes into the client's project under a real person's name, and the
// text has to be read by a human before it goes.
//
// It converts markdown to HTML because ActiveCollab does NOT render markdown in
// comments. A comment posted as raw markdown arrives with literal ** and - visible
// to the client, which is how the first one went out. See docs/DISCOVERIES.md.

import { readFileSync, existsSync } from 'node:fs'
import { basename, dirname, join, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'
import { createInterface } from 'node:readline/promises'

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..')

const C = process.stdout.isTTY
  ? { dim: '\x1b[2m', red: '\x1b[31m', green: '\x1b[32m', yellow: '\x1b[33m', bold: '\x1b[1m', off: '\x1b[0m' }
  : { dim: '', red: '', green: '', yellow: '', bold: '', off: '' }

const die = (m) => { console.error(`${C.red}error${C.off} ${m}`); process.exit(1) }

const args = process.argv.slice(2)
const SEND = args.includes('--send')
const VALUED = ['--env', '--project', '--attach', '--as', '--hold-if-new-since']
const flag = (name) => { const i = args.indexOf(name); return i >= 0 ? args[i + 1] : undefined }
const ENV_PATH = resolve(ROOT, flag('--env') || '.env.activecollab')
const PROJECT_ID = flag('--project') || process.env.ACTIVECOLLAB_PROJECT_ID || '264'
const [task, file] = args.filter((a, i) => !a.startsWith('--') && !VALUED.includes(args[i - 1]))
const ATTACH = args.filter((a, i) => args[i - 1] === '--attach')
for (const path of ATTACH) if (!existsSync(path)) die(`no such file to attach: ${path}`)
if (!task || !file) die('usage: script/ac_comment <task-number|task-id> <file.md> [--env .env.x --project <id>] [--send]')
if (!existsSync(file)) die(`no such file: ${file}`)

// ── credentials ─────────────────────────────────────────────────────────────

function env() {
  if (!existsSync(ENV_PATH)) die(`missing ${ENV_PATH} — create it with: script/ac_token`)
  const out = {}
  for (const line of readFileSync(ENV_PATH, 'utf8').split('\n')) {
    const m = line.match(/^\s*([A-Z_]+)\s*=\s*(.*)$/)
    if (m) out[m[1]] = m[2].trim().replace(/^["']|["']$/g, '')
  }
  if (!out.ACTIVECOLLAB_TOKEN) die(`${ENV_PATH} has no ACTIVECOLLAB_TOKEN`)
  if (!out.ACTIVECOLLAB_URL) die(`${ENV_PATH} has no ACTIVECOLLAB_URL`)
  out.ACTIVECOLLAB_URL = out.ACTIVECOLLAB_URL.replace(/\/$/, '')
  return out
}
const E = env()

async function api(path, init = {}) {
  const res = await fetch(`${E.ACTIVECOLLAB_URL}/api/v1${path}`, {
    ...init,
    headers: {
      'X-Angie-AuthApiToken': E.ACTIVECOLLAB_TOKEN,
      ...(init.body ? { 'Content-Type': 'application/json' } : {}),
      ...init.headers,
    },
    signal: AbortSignal.timeout(30_000),
  })
  const text = await res.text()
  if (!res.ok) die(`${init.method || 'GET'} ${path} -> HTTP ${res.status}\n${text.slice(0, 500)}`)
  try { return JSON.parse(text) } catch { die(`${path} returned non-JSON:\n${text.slice(0, 300)}`) }
}

// ── markdown -> the HTML ActiveCollab actually renders ──────────────────────

const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')

// Inline marks are applied AFTER escaping, so a literal < in the source stays literal
// and only our own tags survive.
// A mention, written @[Jane Doe](user:1), becomes the span ActiveCollab's
// own editor inserts (read from its index.js on 4 Nov 2026, buildMentionAttributes:
// class new_mention, data-type user, data-user-id). User ids: GET /users.
function inline(s) {
  return esc(s)
    .replace(/@\[([^\]]+)\]\(user:(\d+)\)/g,
      '<span class="new_mention" data-type="user" data-context="" data-user-id="$2">$1</span>')
    .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/`([^`]+)`/g, '<code>$1</code>')
}

function toHtml(md) {
  const out = []
  let list = null
  const closeList = () => { if (list) { out.push(`</${list}>`); list = null } }

  for (const raw of md.split('\n')) {
    const line = raw.trimEnd()

    if (!line.trim()) { closeList(); continue }
    if (/^---+$/.test(line.trim())) { closeList(); out.push('<hr>'); continue }

    // Headings become bold paragraphs. ActiveCollab renders <h2> at a size that looks
    // shouty next to the client's own comments.
    const h = line.match(/^(#{1,6})\s+(.*)$/)
    if (h) { closeList(); out.push(`<p><strong>${inline(h[2])}</strong></p>`); continue }

    const ul = line.match(/^\s*[-*]\s+(.*)$/)
    if (ul) {
      if (list !== 'ul') { closeList(); out.push('<ul>'); list = 'ul' }
      out.push(`<li>${inline(ul[1])}</li>`)
      continue
    }

    const ol = line.match(/^\s*\d+[.)]\s+(.*)$/)
    if (ol) {
      if (list !== 'ol') { closeList(); out.push('<ol>'); list = 'ol' }
      out.push(`<li>${inline(ol[1])}</li>`)
      continue
    }

    closeList()
    out.push(`<p>${inline(line)}</p>`)
  }
  closeList()
  return out.join('\n')
}

// ── who is posting ──────────────────────────────────────────────────────────
// Two people post on the team tracker from this machine: Luan (shop and 6.0 tasks) and Huy
// (landing tasks, his own token in .env.ac_huy since 12 Nov 2026). A comment under the wrong
// name cannot be taken back in the client's eyes, so on the team site --as is required and must
// match the user the token belongs to.
const AS = flag('--as')
const session = await api('/user-session').catch(() => null)
const meId = session?.logged_user_id ?? session?.user_id ?? null
const me = meId ? await api(`/users/${meId}`).then((u) => u.single ?? u).catch(() => null) : null
const meName = me?.display_name || [me?.first_name, me?.last_name].filter(Boolean).join(' ') || `user ${meId}`
if (/\.env\.ac_(team|huy)$/.test(ENV_PATH) && !AS) die(`say who is posting: --as luan or --as huy (this token is ${meName})`)
if (AS && !meName.toLowerCase().includes(AS.toLowerCase())) die(`--as ${AS} but this token belongs to ${meName}. Nothing sent. Use the other --env.`)

// ── resolve the task ────────────────────────────────────────────────────────

const payload = await api(`/projects/${PROJECT_ID}/tasks`)
const tasks = payload.tasks || []
const target = tasks.find((t) => String(t.task_number) === String(task)) ||
               tasks.find((t) => String(t.id) === String(task))
if (!target) {
  die(`no open task matching "${task}" in project ${PROJECT_ID}\n  open tasks: ` +
      tasks.map((t) => `#${t.task_number} (${t.id}) ${t.name}`).join('\n              '))
}

// Second lock against the wrong account (Luan, 12 Nov 2026: "tuyệt đối ko được nhầm 2 acc"): on
// the team site the poster must be one of the task's assignees, unless --off-assignment says the
// exception is meant. Luan's answer to a question put to him on Huy's task is such an exception;
// Huy posting on a task that is not his never should be.
const full = await api(`/projects/${PROJECT_ID}/tasks/${target.id}`).then((t) => t.single ?? t)
const assignees = full.assignee_ids?.length ? full.assignee_ids : [full.assignee_id].filter(Boolean)
const OFF = args.includes('--off-assignment')
if (AS && meId && !assignees.includes(meId) && !OFF) {
  const names = await Promise.all(assignees.map((id) => api(`/users/${id}`).then((u) => (u.single ?? u).display_name).catch(() => `user ${id}`)))
  die(`${meName} is not assigned to task #${target.task_number} (assigned: ${names.join(', ') || 'nobody'}). Nothing sent.\n` +
      `  If ${meName} really is meant to post here, add --off-assignment.`)
}

// A queued reply (script/ac_queue) goes out up to hours after it was written. If someone else has
// commented on the task since, the reply may answer a question that has moved on, so it is held
// for a human to read instead of posted. Exit 3 means held, nothing sent.
const SINCE = Number(flag('--hold-if-new-since') || 0)
if (SINCE) {
  const thread = await api(`/comments/task/${target.id}`).then((r) => r.comments || r).catch(() => null)
  if (!Array.isArray(thread)) { console.error(`${C.red}held${C.off} could not read the thread to check for new comments; nothing sent`); process.exit(3) }
  const newer = thread.filter((c) => c.created_on > SINCE && c.created_by_id !== meId)
  if (newer.length) {
    console.error(`${C.red}held${C.off} ${newer.length} new comment(s) on task #${target.task_number} since this was queued, by ${[...new Set(newer.map((c) => c.created_by_name))].join(', ')}; nothing sent`)
    process.exit(3)
  }
}

const md = readFileSync(file, 'utf8')
const html = toHtml(md)

// ── show it ─────────────────────────────────────────────────────────────────

const bar = '─'.repeat(72)
console.log('')
console.log(`${C.bold}to${C.off}      Task #${target.task_number} (${target.id})  ${target.name}`)
console.log(`${C.bold}url${C.off}     ${E.ACTIVECOLLAB_URL}/projects/${PROJECT_ID}?modal=Task-${target.id}-${PROJECT_ID}`)
console.log(`${C.bold}from${C.off}    ${file}  ${C.dim}(${md.trim().length} chars)${C.off}`)
console.log('')
console.log(`${C.dim}${bar}${C.off}`)
console.log(md.trim())
console.log(`${C.dim}${bar}${C.off}`)
console.log('')

// The one thing a preview must prove, because it is the failure we already shipped
// once: no markdown syntax survives into what the client sees.
// Tables are not converted, on purpose: ActiveCollab comments have no table styling
// worth the effort. But an unconverted table emits raw pipes to the client, so it is
// caught here rather than discovered in the thread.
if (/^\s*\|.*\|\s*$/m.test(md)) {
  console.log(`${C.yellow}warning${C.off} markdown table detected. Tables are not converted and will show as raw pipes. Rewrite as a list.`)
  console.log('')
}

// Em dashes read as machine-written and get flagged every time. Cheaper to catch here
// than to notice after it is posted under a real person's name.
const dashes = (md.match(/[—–]/g) || []).length
if (dashes) {
  console.log(`${C.yellow}warning${C.off} ${dashes} em/en dash(es). They read as AI. Use a comma or a full stop.`)
  console.log('')
}

const leaked = (html.replace(/<[^>]+>/g, '').match(/\*\*|^\s*[-*]\s|^#{1,6}\s/gm) || [])
if (leaked.length) {
  console.log(`${C.yellow}warning${C.off} markdown that will show literally to the client: ${[...new Set(leaked)].join(' ')}`)
  console.log('')
}

console.log(`${C.bold}as      ${meName}${meId ? ` (user ${meId})` : ''}${C.off}`)
if (ATTACH.length) console.log(`attach  ${ATTACH.map((p) => basename(p)).join(', ')}`)
console.log('')

if (!SEND) {
  console.log(`${C.dim}preview only. nothing sent.${C.off}`)
  console.log(`to post it:  script/ac_comment ${args.filter((a) => a !== '--send').join(' ')} --send`)
  process.exit(0)
}

// ── send ────────────────────────────────────────────────────────────────────

const rl = createInterface({ input: process.stdin, output: process.stdout })
const answer = await rl.question(`${C.yellow}post this to the client's task as ${meName}? ${C.off}[y/N] `)
rl.close()
if (!/^y(es)?$/i.test(answer.trim())) {
  console.log('not sent.')
  process.exit(0)
}

// Files go up first and the comment carries their upload codes. The form field must be named
// `file`: `attachment` (the name in older examples) answers 200 with an empty list and uploads
// nothing (measured 10 Nov 2026).
const codes = []
for (const path of ATTACH) {
  const form = new FormData()
  form.append('file', new Blob([readFileSync(path)]), basename(path))
  let up
  try {
    up = await fetch(`${E.ACTIVECOLLAB_URL}/api/v1/upload-files`, {
    method: 'POST',
    headers: { 'X-Angie-AuthApiToken': E.ACTIVECOLLAB_TOKEN, 'User-Agent': 'spree-plan-tools/1.0' },
    body: form,
    signal: AbortSignal.timeout(300_000), // a 4 MB report took over 2 minutes to upload on 12 Nov 2026
  })
  } catch (e) {
    die(`upload of ${path} failed (${e.name}: ${e.message}); nothing was posted`)
  }
  const uploaded = await up.json().catch(() => [])
  const code = (Array.isArray(uploaded) ? uploaded[0] : uploaded)?.code
  if (!up.ok || !code) die(`upload of ${path} failed (HTTP ${up.status}); nothing was posted`)
  codes.push(code)
}

const res = await api(`/comments/task/${target.id}`, {
  method: 'POST',
  body: JSON.stringify({ body: html, ...(codes.length ? { attach_uploaded_files: codes } : {}) }),
})

// ActiveCollab wraps a created object in { single: ... } on some endpoints and returns
// it bare on others. Reading res.id alone printed "comment undefined" for a comment
// that had in fact posted, which is the worst way to be wrong about a write.
const created = res.single ?? res

// Read the comment back from the tracker and say plainly whose name it carries.
const back = created.id ? await api(`/comments/task/${target.id}`).then((r) => (r.comments || r).find((c) => c.id === created.id)).catch(() => null) : null
if (back && back.created_by_id !== meId) {
  console.log(`${C.red}WRONG ACCOUNT${C.off}: comment ${created.id} carries ${back.created_by_name} (user ${back.created_by_id}), not ${meName}. Tell Luan now.`)
}

console.log('')
console.log(`${C.green}posted${C.off} comment ${created.id ?? '(id not returned)'} on Task #${target.task_number} as ${back?.created_by_name ?? meName}`)
if (codes.length) console.log(`        attached ${(created.attachments || []).map((a) => `${a.name} (${a.size} bytes)`).join(', ') || 'NOTHING: check the thread'}`)
console.log(`${C.dim}run script/ac_sync to fold it back into the plan${C.off}`)
