#!/usr/bin/env python3
"""Prove every shop has its OWN copy, rather than quietly borrowing another's.

    script/check_shop_content

The storefront reads its words from per-shop maps keyed by country code:

    HOME_BY_SHOP[shop] ?? HOME_BY_SHOP.nz

That `??` is the whole problem. A shop with no entry does not fail, does not warn
and does not render an empty page. It renders ANOTHER SHOP'S PAGE, completely and
convincingly, and the only way to notice is to read the words and know they
belong somewhere else.

── what it cost, on 18 Aug ──────────────────────────────────────────────────

HOME_BY_SHOP had two entries, for two of the five shops. So three shops served
the same country's hero, the same About story and, worst of all, the same
shipping notice. One of them told customers in their country that their G.S.T
was pre-paid, which is not a thing that exists there.

Everything else about those shops was correct. They passed 27 of 27 end to end
checks, sold correctly, and looked finished. The client found it himself and
asked us to compare the new shops against his current ones.

── why this check and not a type ────────────────────────────────────────────

A Record<string, T> cannot require a key per shop, and making the maps exhaustive
in TypeScript would mean naming the client's shops in a type, in a public repo.
The shop list lives in the gitignored estate file, so the check reads that and
compares. It also means adding a sixth shop to the estate makes this fail until
its words exist, which is the right moment to be told.
"""

import os
import re
import sys

CONTENT = "storefront/src/lib/blocks/content.ts"
ESTATE = os.environ.get("ESTATE_FILE", ".estate")

# Every map that decides what a shop SAYS or LOOKS LIKE. A shop missing from one
# of these is serving another shop's identity, not merely missing a nicety.
REQUIRED = [
    "HOME_BY_SHOP",
    "PAGES_BY_SHOP",
    "SITE_LINKS",
    "BRAND_BY_SHOP",
    "FOOTER_BY_SHOP",
    "CONTACT_BY_SHOP",
]

# A second, narrower rule for the maps that fall back to something SHARED rather
# than to nothing.
#
# The maps above must have an entry per shop because absence there serves another
# shop's page. These are different: a missing entry falls back to a shared value,
# and sharing is usually correct. The retail shops of one brand share a single
# announcement line, and that is fine, they are one brand.
#
# It stops being fine when the shop is a DIFFERENT identity. The sixth shop
# shipped with the retail brand's own announcement line across the top of every
# page, because ANNOUNCEMENT_BY_SHOP fell back to the shared translation and
# nothing required that shop, a separate brand, to have its own. Every gate
# passed.
#
# The set of "different identity" shops is not a list here, it is the set that
# already declares its own THEME. A shop distinct enough to restyle its whole
# palette is distinct enough that inheriting another shop's sentence is a leak.
# So: every shop in THEME_BY_SHOP must have its own ANNOUNCEMENT_BY_SHOP.
#
# Only the announcement, deliberately. The other soft maps fall back to GENERIC
# defaults, not to another brand's words: SIGN_IN to plain "Sign in",
# SUBSCRIBE_FIELDS to "you@email.com". A themed shop using a generic placeholder
# is not wearing another brand's identity, so requiring it there would fail the
# sixth shop for something that is correct. Measured: it has a theme and an
# announcement of its own, and no SIGN_IN or SUBSCRIBE_FIELDS entry, on purpose.
THEMED_MUST_OWN = [
    ("THEME_BY_SHOP", "ANNOUNCEMENT_BY_SHOP"),
]

# Shops with no storefront of their own are skipped, and the estate already says
# which those are: their storefront domain column is "-". Read from the data
# rather than listed here, because a list in this file would name the client's
# shops and this repository is public.


def shops_from_estate():
    if not os.path.exists(ESTATE):
        return []
    out = []
    with open(ESTATE, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#") or "=" in line.split("|")[0]:
                continue
            parts = line.split("|")
            if len(parts) < 7:
                continue
            # parts[5], not parts[6]. The columns run
            #   0 shop | 1 dir | 2 db | 3 admin port | 4 storefront port
            #   5 STOREFRONT domain | 6 RAILS domain | 7 live url | 8 prefix
            # and this read parts[6] while calling it the storefront domain, so
            # it was deciding whether a shop has a customer facing site by
            # looking at its admin hostname. It skipped a shop that had a
            # storefront and no admin record, which is the sixth shop exactly,
            # and the gate reported ok while that shop had no copy of its own.
            # .estate.example warns about this pair being easy to swap; the
            # warning was written after getting them the wrong way round once.
            name, storefront_domain = parts[0].strip(), parts[5].strip()
            # "-" means the client has not made that shop's record yet.
            if storefront_domain == "-":
                continue
            out.append(name)
    return out


def keys_of(source, const):
    m = re.search(rf"export const {const}[^=]*=\s*\{{(.*?)\n\}}(?: as const)?;", source, re.S)
    if not m:
        return None
    # Top level keys only: two spaces of indent inside the object literal.
    return set(re.findall(r"^  ([A-Za-z0-9_]+)\s*:", m.group(1), re.M))


def main():
    if not os.path.exists(CONTENT):
        print("  no content file on this machine, nothing to check")
        return 0

    shops = shops_from_estate()
    if not shops:
        print("  no estate file on this machine, nothing to check")
        return 0

    source = open(CONTENT, encoding="utf-8").read()
    missing = []
    for const in REQUIRED:
        keys = keys_of(source, const)
        if keys is None:
            missing.append((const, "MAP NOT FOUND", ""))
            continue
        for shop in shops:
            if shop not in keys:
                missing.append((const, shop, sorted(keys)))

    # The narrower rule: a shop that declares its own theme must not inherit a
    # shared identity line.
    for driver_map, identity_map in THEMED_MUST_OWN:
        themed = keys_of(source, driver_map)
        owned = keys_of(source, identity_map)
        if themed is None or owned is None:
            missing.append((identity_map, "MAP NOT FOUND", ""))
            continue
        for shop in sorted(themed):
            if shop not in owned:
                missing.append(
                    (
                        identity_map,
                        shop,
                        f"has its own {driver_map} but falls back to a shared {identity_map}",
                    )
                )

    print(f"  {len(shops)} shop(s) with a storefront, {len(REQUIRED)} content maps")

    if not missing:
        print("\n  ok — every shop has its own copy in every map,")
        print("       and every themed shop has its own announcement")
        return 0

    print()
    for const, shop, have in missing:
        if shop == "MAP NOT FOUND":
            print(f"  {const}: not found in {CONTENT}")
        elif isinstance(have, str):
            # The themed-must-own rule carries a reason rather than a key list.
            print(f"  {const} has no entry for '{shop}'")
            print(f"      {have}")
        else:
            print(f"  {const} has no entry for '{shop}'")
            print(f"      it has: {have}")
    print(
        f"\n  {len(missing)} shop(s) would fall back to another shop's words.\n"
        "\n  That renders convincingly and says nothing. Add the shop's own entry,\n"
        "  read off its own live site with script/pull_page_copy.py."
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
