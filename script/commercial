#!/usr/bin/env bash
#
# Drive the client's commercial shop server.
#
#   script/commercial survey        read-only: what is on the box right now
#   script/commercial prepare       swap, sysctl, certbot. Idempotent.
#   script/commercial ship <shop>   send HEAD to that shop's own directory
#   script/commercial up <shop>     build, start, wait for health
#   script/commercial nginx <shop> [backend|storefront]   vhost, nginx -t, certbot
#   script/commercial admin_image <shop>   his own sign-in picture for /admin
#   script/commercial status        what is deployed and what revision
#   script/commercial ssh           open a shell
#   script/commercial run '<cmd>'   run one command
#
# Why not script/deploy: that one is built for OUR reference box and hardcodes it.
# It assumes a single app in ~/spree, a shared LEMP host with 28 other sites, 1.9 GB
# of RAM, and it protects mysqld from the OOM killer. Every one of those is false
# here: this box is 15 GB, runs nothing but our containers, and holds one shop per
# directory under /srv. Reusing it would have carried over guards that protect a
# database that does not exist while missing the multi-shop layout that does.
#
# The host lives in .env.commercial, which is gitignored. This repo is public and
# the address, user and key path are the client's, not ours.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="$ROOT/.env.commercial"

C_RED=$'\e[31m'; C_GRN=$'\e[32m'; C_YEL=$'\e[33m'; C_DIM=$'\e[2m'; C_BLD=$'\e[1m'; C_OFF=$'\e[0m'
step() { printf '\n%s==>%s %s\n' "$C_BLD" "$C_OFF" "$*"; }
ok()   { printf '  %sok%s   %s\n' "$C_GRN" "$C_OFF" "$*"; }
warn() { printf '  %swarn%s %s\n' "$C_YEL" "$C_OFF" "$*"; }
info() { printf '  %s%s%s\n' "$C_DIM" "$*" "$C_OFF"; }
die()  { printf '%serror%s %s\n' "$C_RED" "$C_OFF" "$*" >&2; exit 1; }

[ -f "$ENV_FILE" ] || die "missing $ENV_FILE"
# shellcheck disable=SC1090
set -a; . "$ENV_FILE"; set +a
: "${COMMERCIAL_HOST:?}" "${COMMERCIAL_USER:?}" "${COMMERCIAL_PORT:=22}" "${COMMERCIAL_KEY:?}"
KEY="${COMMERCIAL_KEY/#\~/$HOME}"
[ -f "$KEY" ] || die "ssh key not found at $KEY"

# Paths that belong to the CLIENT and are gitignored on purpose, so `git archive` can
# never carry them. Shipped separately by cmd_ship. Anything added to .gitignore that
# the running app actually needs has to be listed here too, or the shop silently falls
# back to Spree's defaults.
CLIENT_ASSETS=(
  "app/views/spree/order_mailer"
  "app/views/spree/shipment_mailer"
  "app/views/spree/reimbursement_mailer"
  "app/models/spree/calculator/shipping"
  "config/rural_postcodes.txt"
  # The autoload rule the calculators above depend on. It is gitignored for the same
  # reason they are, so git archive leaves it behind, and without it Zeitwerk cannot
  # derive the constant one of those files declares. In production Rails eager loads,
  # so that is not a quiet failure: the container will not boot at all. It took the
  # backend down on the first deploy after the calculator went up without it.
  "config/initializers/inflections.rb"
  # The words on the storefront's pages. Gitignored because this repository is
  # public and the copy names the client, his brand and his founder; carried by
  # hand for the same reason as everything above. Without it the Next.js build
  # fails on a missing import rather than degrading, which is the better of the
  # two failures but still a failed deploy.
  "storefront/src/lib/blocks/content.ts"
  # His logo, favicons, social cards and home page photographs. Gitignored for the
  # same reason as the copy: this repository is public and they are his brand.
  # Missing, the pages still render, so this one degrades quietly — which is why
  # it is checked inside the finished image rather than trusted.
  "storefront/public/brand"
  # Where a retired page now sends people. Gitignored for the same reason as the
  # copy: a source path and a destination both name his shops. Missing, the build
  # succeeds with no redirects at all, so a retired URL would quietly go back to
  # answering 200 with a not-found body.
  "storefront/src/lib/blocks/retired-urls.json"
  "storefront/public/favicon.ico"
  # One file per shop, each holding that shop's own email wording, selected at
  # boot by config/initializers/shop_locale.rb from the SHOP variable. Outside
  # config/locales on purpose: Rails globs that tree recursively, so a
  # subdirectory under it is loaded into every shop, which is the exact failure
  # this replaces. Missing, the shop refuses to boot rather than mailing another
  # shop's brand, which is what it did before this existed.
  "config/shop_locales"
  # Which category fills each home page row, per shop. Gitignored because the
  # shop names are the client's brands. Missing on the server, script/shop_host
  # falls back to the three retail permalinks, which on a shop that does not have
  # them returns three empty ids and the build refuses. So this one fails loudly
  # rather than quietly, but it still has to travel.
  "config/shop_collections"
  # Which shops serve clean URLs. Gitignored because its keys are shop names,
  # so git archive leaves it behind and every shop would silently revert to the
  # prefixed shape on the next deploy.
  "config/clean_url_shops"
  # Which calculators each shop offers in its admin dropdown, read at boot by
  # config/initializers/shipping_calculators.rb. Gitignored because its keys are
  # shop names. Missing on the server, that initializer raises rather than
  # registering nothing: a shop without it boots, shows only the six calculators
  # Spree ships with, and keeps quoting correctly right up until somebody edits
  # the shipping method. Nothing fails and nothing logs, so it must not degrade.
  "config/shop_calculators"
  # Per-shop template overrides, prepended to the view path by
  # config/initializers/shop_views.rb. Gitignored because the directory names the
  # shop. Missing on the server, that shop silently falls back to the shared
  # template, which is the design six other shops use: nothing errors and the
  # email still sends, which is the failure this whole list exists for.
  "app/views/shops"
)
# Locale files are a glob, so they are collected at ship time rather than listed.
while IFS= read -r f; do CLIENT_ASSETS+=("$f"); done < <(cd "$ROOT" && ls config/locales/*.yml 2>/dev/null | grep -vE "/(en|ar|bg|ca|cs|da|de|el|es|et|fa|fi|fr|he|hi|hr|hu|id|it|ja|ko|lt|lv|mk|nb|nl|pl|pt|ro|ru|sk|sl|sq|sr|sv|th|tr|uk|vi|zh)\.yml$" || true)

# BatchMode so a wrong key fails immediately instead of hanging on a password prompt.
host() {
  ssh -i "$KEY" -p "$COMMERCIAL_PORT" -o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=15 -o ServerAliveCountMax=40 -o ConnectTimeout=15 \
      -o StrictHostKeyChecking=accept-new "$COMMERCIAL_USER@$COMMERCIAL_HOST" "$@"
}

# ── survey ──────────────────────────────────────────────────────────────────

cmd_survey() {
  step "Connecting to $COMMERCIAL_HOST:$COMMERCIAL_PORT"
  host 'true' || die "cannot connect. If the ssh port has changed, update COMMERCIAL_PORT in .env.commercial"
  ok "connected"

  host '
    echo "--- identity ---"
    echo "host      $(hostname)"
    . /etc/os-release; echo "os        $PRETTY_NAME"
    echo "kernel    $(uname -r)"
    echo "cpu       $(nproc) cores"
    echo "ram       $(free -h | awk "/Mem:/{print \$2}") total, $(free -h | awk "/Mem:/{print \$7}") available"
    echo "swap      $(free -h | awk "/Swap:/{print \$2}")"
    echo "disk      $(df -h / | awk "NR==2{print \$4\" free of \"\$2}")"
    echo "--- tooling ---"
    echo "docker    $(docker --version 2>/dev/null || echo MISSING)"
    echo "compose   $(docker compose version --short 2>/dev/null || echo MISSING)"
    echo "nginx     $(nginx -v 2>&1 | sed "s|nginx version: ||" || echo MISSING)"
    echo "certbot   $(certbot --version 2>/dev/null || echo MISSING)"
    echo "--- exposure ---"
    echo "ssh       port $(sshd -T 2>/dev/null | awk "/^port /{print \$2}" | paste -sd, -), rootlogin $(sshd -T 2>/dev/null | awk "/^permitrootlogin/{print \$2}"), passwordauth $(sshd -T 2>/dev/null | awk "/^passwordauthentication/{print \$2}")"
    echo "ufw       $(ufw status 2>/dev/null | head -1 | sed "s/Status: //")"
    echo "vhosts    $(ls -1 /etc/nginx/sites-enabled/ 2>/dev/null | paste -sd, - || echo none)"
    echo "--- shops ---"
    for d in /srv/*/; do
      n=$(basename "$d")
      f=$(ls -A "$d" 2>/dev/null | wc -l)
      printf "%-26s %s\n" "$n" "$([ "$f" -eq 0 ] && echo "empty" || echo "$f entries")"
    done
    echo "--- containers ---"
    docker ps -a --format "{{.Names}}  {{.Image}}  {{.Status}}" 2>/dev/null | sed "s/^/  /" || true
    [ -z "$(docker ps -aq 2>/dev/null)" ] && echo "  none"
  ' | sed 's/^/  /'
}

# ── prepare ─────────────────────────────────────────────────────────────────

cmd_prepare() {
  step "Swap"
  # 4 GB on a 15 GB box is insurance, not virtual memory. Spree's asset build is the
  # spike that matters. NOTE: never swapoff an active swapfile to resize it; pulling
  # those pages back into RAM is itself enough to invoke the OOM killer. If more is
  # needed later, add a SECOND file. See docs/DEPLOY.md.
  host 'if swapon --show --noheadings | grep -q .; then
      echo "already on: $(swapon --show --noheadings --raw | tr "\n" " ")"
    else
      fallocate -l 4G /swapfile
      chmod 600 /swapfile
      mkswap /swapfile >/dev/null
      swapon /swapfile
      grep -q "^/swapfile " /etc/fstab || echo "/swapfile none swap sw 0 0" >> /etc/fstab
      echo "created 4G /swapfile and persisted it in fstab"
    fi
    sysctl -qw vm.swappiness=10
    grep -q "^vm.swappiness" /etc/sysctl.conf || echo "vm.swappiness=10" >> /etc/sysctl.conf
    echo "swappiness now $(cat /proc/sys/vm/swappiness)"' | sed 's/^/  /'

  step "certbot"
  host 'if command -v certbot >/dev/null; then
      echo "already installed: $(certbot --version 2>&1)"
    else
      DEBIAN_FRONTEND=noninteractive apt-get update -qq
      DEBIAN_FRONTEND=noninteractive apt-get install -y -qq certbot python3-certbot-nginx >/dev/null
      echo "installed $(certbot --version 2>&1)"
    fi' | sed 's/^/  /'

  step "Verifying"
  host 'test -n "$(swapon --show --noheadings)" && echo "swap active" || echo "SWAP MISSING"
    command -v certbot >/dev/null && echo "certbot present" || echo "CERTBOT MISSING"
    grep -q "^/swapfile " /etc/fstab && echo "swap survives reboot" || echo "SWAP NOT IN FSTAB"' | sed 's/^/  /'
  ok "prepare finished"

  warn "not done here, and deliberately:"
  info "  ssh hardening belongs to whoever owns the box. Moving the port and setting"
  info "  PasswordAuthentication no from here risks locking the owner out of their"
  info "  own server, so it is asked for rather than done."
}

# ── which directory is this shop ────────────────────────────────────────────

# The shop must ALREADY be there. Every command here changes a shop that exists;
# none of them creates one.
#
# ship used to open with `mkdir -p /srv/$shop/app`, which turns a name that is
# wrong into a silent success. On 1 Sep a ship was run with the name of a shop
# that lives on the OTHER server. This box had never heard of it, mkdir made the
# directory, tar filled it with 57 MB, and the run printed
#
#   ok   45 client files in place
#
# Nothing was deployed, the real shop was untouched, and nothing said so. It
# surfaced only because the next command wanted a .env that the invented
# directory did not have.
#
# Note that .estate is NOT the mapping to use here. That file describes the other
# server, whose directories are named after the domain; this box uses the shop
# name and holds shops that do not appear in it at all. The two estates are
# separate and the only safe common rule is: if it is not there, stop.
require_shop_dir() {
  local dir="/srv/$1"
  host "test -d '$dir'" \
    || die "$dir does not exist on this server, so nothing was sent. Check the name, and check you meant THIS box: the seven-shop estate is a different machine and ships with script/shop_host. 'script/commercial survey' lists what is actually here."
  printf '%s' "$dir"
}

# ── ship ────────────────────────────────────────────────────────────────────

# Send the current commit to the shop's own directory, plus the compose file.
#
# `git archive` rather than `git clone`: no push, no deploy key, no branch to
# keep in step, and the tree that lands is exactly one commit with nothing
# uncommitted smuggled in. The SHA is written next to it so the box can always
# answer "what is actually running here".
cmd_ship() {
  local shop="${1:?usage: script/commercial ship <shop>}"
  local dir; dir="$(require_shop_dir "$shop")"
  local sha; sha="$(git -C "$ROOT" rev-parse HEAD)"

  if [ -n "$(git -C "$ROOT" status --porcelain)" ]; then
    warn "working tree is dirty. Shipping HEAD ($(git -C "$ROOT" rev-parse --short HEAD)), not what is on disk."
  fi

  step "Shipping ${sha:0:7} to $dir/app"
  host "mkdir -p '$dir/app'"   # inside a shop that require_shop_dir already proved exists
  git -C "$ROOT" archive --format=tar HEAD | host "tar -x -C '$dir/app'"
  host "echo '$sha' > '$dir/app/REVISION'"
  ok "$(host "find '$dir/app' -type f | wc -l | tr -d ' '") files"

  step "Compose file"
  host "cat > '$dir/docker-compose.yml'" < "$ROOT/deploy/commercial/docker-compose.yml"
  ok "installed"

  # git archive ships HEAD, and HEAD deliberately excludes the client's own files:
  # this repo is public and their email designs, brand copy and shipping rates are
  # theirs. Which means a shop deployed from the archive alone runs Spree's stock
  # emails instead of the client's, with no error and nothing to notice. Found that
  # by looking, after telling the client the shop was up.
  # Gate, before anything is sent. Every file the app loads that git ignores must be in
  # CLIENT_ASSETS, or the server gets a tree missing code it needs and the container
  # will not boot. That is not hypothetical: it took the backend down for 20 minutes.
  if [ -x "$ROOT/script/check_deploy_assets" ]; then
    "$ROOT/script/check_deploy_assets" >/dev/null 2>&1 || {
      "$ROOT/script/check_deploy_assets" || true
      die "refusing to ship with files the application needs and the archive will not carry"
    }
  fi

  step "Client assets"
  local sent=0
  local tmpf; tmpf="$(mktemp)"
  : > "$tmpf"
  for p in "${CLIENT_ASSETS[@]}"; do
    [ -e "$ROOT/$p" ] || continue
    echo "$p" >> "$tmpf"
    sent=$((sent + 1))
  done

  if [ "$sent" -eq 0 ]; then
    warn "no client assets found locally. The shop will send stock Spree emails."
  else
    # COPYFILE_DISABLE stops macOS bsdtar writing an AppleDouble `._name` sidecar
    # for every file carrying an extended attribute. Those land in config/locales
    # next to the real thing, they match the `*.yml` glob Rails loads translations
    # from, and they are binary. Harmless until the day one is parsed, and then a
    # boot failure in a file nobody wrote.
    COPYFILE_DISABLE=1 tar -C "$ROOT" -cf - -T "$tmpf" | host "tar -x -C '$dir/app'"
    # Sweep any left by an earlier ship that predates the line above.
    host "find '$dir/app' -name '._*' -type f -delete 2>/dev/null || true"
    ok "$(host "find '$dir/app/app/views/spree' '$dir/app/config/locales' '$dir/app/app/models/spree/calculator' -type f 2>/dev/null | wc -l | tr -d ' '") client files in place"
  fi
  rm -f "$tmpf"
}

# ── build and run ───────────────────────────────────────────────────────────

# Whether this shop is served without the /{country}/{locale} prefix, from
# config/clean_url_shops, keyed by the shop's own SHOP_KEY.
#
# Read from a file for the same reason script/shop_host reads it from one: a
# setting typed on a command line is a setting that is missing the next time
# somebody else rebuilds the shop, and this one moves every address on the shop
# at once. Written into .env, because Next inlines NEXT_PUBLIC_* while building
# and Compose reads its build args from there.
#
# Both directions. Taking a shop's line out of the file and rebuilding must put
# the prefix back, and an add-only version would leave a shop on clean URLs with
# nothing in the file saying so.
sync_clean_urls() {
  local dir="$1"
  local key; key=$(host "grep -m1 '^SHOP_KEY=' '$dir/.env' 2>/dev/null | cut -d= -f2-" | tr -d '\r"')
  local want=""
  if [ -n "$key" ] && [ -f "$ROOT/config/clean_url_shops" ]; then
    while read -r c_shop _; do
      case "$c_shop" in ''|\#*) continue;; esac
      [ "$c_shop" = "$key" ] && want=1
    done < "$ROOT/config/clean_url_shops"
  fi

  host "cd '$dir' && sed -i '/^CLEAN_URLS=/d' .env && ${want:+echo 'CLEAN_URLS=1' >> .env;} true"
  if [ -n "$want" ]; then
    ok "clean URLs ON for $key: every address served without a country or language prefix"
  else
    info "clean URLs off for ${key:-this shop}: addresses keep the /{country}/{locale} prefix"
  fi
}

cmd_up() {
  local shop="${1:?usage: script/commercial up <shop>}"
  local dir; dir="$(require_shop_dir "$shop")"

  host "test -f '$dir/.env'" || die "no $dir/.env yet. Create it first."

  sync_clean_urls "$dir"

  step "Building (this box has the cores for it, so no registry is involved)"
  # web AND storefront. Building only web is a deploy that runs clean, reports
  # success, and changes nothing on the front end, which is where most changes
  # actually are. That trap has cost hours more than once.
  host "cd '$dir' && docker compose build --progress plain web 2>&1 | tail -20"
  host "cd '$dir' && docker compose --profile storefront build --progress plain storefront 2>&1 | tail -20"

  step "Starting"
  # --profile storefront, or the storefront service is skipped entirely. It carries
  # profiles: ["storefront"], so a bare `up -d` starts postgres and web, reports
  # success, and leaves the front end on the image it was already running. The
  # build above would have been thrown away.
  host "cd '$dir' && docker compose --profile storefront up -d"

  step "Waiting for health"
  host "cd '$dir' && for i in \$(seq 1 60); do
      s=\$(docker compose ps web --format '{{.Health}}' 2>/dev/null)
      [ \"\$s\" = healthy ] && { echo \"healthy after \${i}0s\"; exit 0; }
      [ \"\$s\" = unhealthy ] && { echo 'UNHEALTHY'; docker compose logs web --tail 40; exit 1; }
      sleep 10
    done
    echo 'TIMED OUT waiting for health'; docker compose logs web --tail 40; exit 1"
  ok "$shop is up"
}

# ── nginx + TLS ─────────────────────────────────────────────────────────────

# Install the vhost, test it, reload, then let certbot add TLS.
#
# `nginx -t` is a hard gate. A vhost that fails to parse takes down every OTHER
# site on the box the moment nginx is reloaded, so the symlink comes out again
# rather than being left in place to be fixed later.
cmd_nginx() {
  local shop="${1:?usage: script/commercial nginx <shop> [backend|storefront]}"
  local which="${2:-backend}"
  local dir; dir="$(require_shop_dir "$shop")"

  # Two vhosts per shop: the API and admin on store.<domain>, and the shop customers
  # see on <domain>. Same template, different upstream, because nothing about the
  # proxying differs. certbot handles each name separately.
  local domain port
  case "$which" in
    backend)
      domain="$(host "grep -E '^RAILS_HOST=' '$dir/.env' | cut -d= -f2-")"
      port="$(host "grep -E '^SPREE_PORT=' '$dir/.env' | cut -d= -f2-")" ;;
    storefront)
      # STOREFRONT_URL carries a scheme; the vhost wants a bare hostname.
      domain="$(host "grep -E '^STOREFRONT_URL=' '$dir/.env' | cut -d= -f2-" | sed -E 's|^https?://||; s|/.*$||')"
      port="$(host "grep -E '^STOREFRONT_PORT=' '$dir/.env' | cut -d= -f2-")" ;;
    *) die "second argument must be backend or storefront" ;;
  esac
  [ -n "$domain" ] && [ -n "$port" ] || die "could not read the host and port for $which from $dir/.env"
  local slug="${domain//./_}"

  step "Checking DNS before anything else"
  # certbot cannot issue for a name that does not point here, and finding that
  # out after the vhost is live is a worse place to learn it.
  local resolved; resolved="$(dig +short "$domain" A | tail -1)"
  if [ "$resolved" != "$COMMERCIAL_HOST" ]; then
    die "$domain resolves to ${resolved:-nothing}, not $COMMERCIAL_HOST. Fix DNS first."
  fi
  ok "$domain -> $resolved"

  step "Installing the vhost"
  sed -e "s|__DOMAIN__|$domain|g" -e "s|__PORT__|$port|g" -e "s|__SLUG__|$slug|g" \
      "$ROOT/deploy/commercial/nginx.conf.template" \
    | host "cat > /etc/nginx/sites-available/$domain"
  host "ln -sf /etc/nginx/sites-available/$domain /etc/nginx/sites-enabled/$domain"

  step "nginx -t"
  if ! host "nginx -t"; then
    host "rm -f /etc/nginx/sites-enabled/$domain"
    die "config rejected, symlink removed and nginx left untouched"
  fi
  host "systemctl reload nginx"
  ok "vhost live on http://$domain"

  step "certbot"
  host "certbot --nginx -d '$domain' --non-interactive --agree-tos --register-unsafely-without-email --redirect" \
    || warn "certbot failed. The site still works over http; run it again once the cause is fixed."
  host "nginx -t && systemctl reload nginx" >/dev/null 2>&1 || true
  ok "done"
}

# The sign-in picture for this shop's admin, which is his own artwork.
#
# This command exists because its absence was mistaken for a lost file. On 15 Sep
# he wrote "I sent the admin login image at the start but it never got added". The
# image was never lost: tmp/client/admin_login/business.png has been there since
# 24 Aug and is the same picture he re-sent, to within JPEG noise (mean difference
# 1.03 of 255). What was missing was this command. The seven shops on the OTHER
# box all have their picture because script/shop_host has an admin_image; this
# script did not, so the one shop that lives here never got one.
#
# Reads ENV["ADMIN_LOGIN_IMAGE"] at app/views/layouts/spree/minimal.html.erb:19,
# falling back to Spree's own asset, so an unset variable is a plain default
# rather than a broken page.
cmd_admin_image() {
  local shop="${1:?usage: script/commercial admin_image <shop> [path/to/picture.png]}"
  local dir; dir="$(require_shop_dir "$shop")"

  # A shop has TWO names and they are not the same one.
  #
  # The directory on this box is named after the shop's DOMAIN, while the
  # storefront's own key for the same shop is a shorter word, and that shorter
  # word is what tmp/client/admin_login is filed under. Looking the picture up by
  # the directory name alone finds nothing and reads as "he never sent one", which
  # is exactly the wrong conclusion: on the one shop this has happened to, the
  # picture had been on disk for three weeks.
  #
  # So: try the directory name, then the storefront key from the override file,
  # and let an explicit path win over both.
  local src="${2:-}"
  if [[ -z "$src" ]]; then
    local candidates=("tmp/client/admin_login/$shop.png")
    local key; key=$(host "grep -m1 '^SHOP_KEY=' '$dir/.env' 2>/dev/null | cut -d= -f2-" | tr -d '\r' | tr -d '"')
    [[ -n "$key" ]] && candidates+=("tmp/client/admin_login/$key.png")
    for c in "${candidates[@]}"; do
      [[ -f "$c" ]] && { src="$c"; break; }
    done
    [[ -n "$src" ]] || die "no picture found. Tried: ${candidates[*]}. Pass one explicitly as the second argument."
    info "using $src"
  fi
  [[ -f "$src" ]] || die "no picture at $src. They come from his own tracker task, and this script does not invent one."

  local local_bytes; local_bytes=$(wc -c < "$src" | tr -d ' ')
  step "Sending the sign-in picture for $shop ($local_bytes bytes)"
  host "mkdir -p '$dir/brand'"
  # A pipe rather than scp: host() already settles the key, the port and the user,
  # and one path to the server is one path to get wrong.
  host "cat > '$dir/brand/admin_login.png'" < "$src"

  # Verify the bytes arrived. A truncated image is a broken page that answers 200,
  # which is the failure class this repo keeps meeting.
  local remote_bytes; remote_bytes=$(host "stat -c %s '$dir/brand/admin_login.png'" | tr -d '\r')
  [[ "$remote_bytes" == "$local_bytes" ]] \
    || die "the picture arrived truncated: $remote_bytes bytes on the server against $local_bytes here"
  ok "picture on the server, $remote_bytes bytes"

  # The mount and the variable, each added only if absent so a second run is a
  # no-op. Braces around the awk and the mv: without them the shell reads
  # `(grep || awk) && mv` and the mv runs even when awk was skipped, moving a
  # .compose.new left by an interrupted run over a good docker-compose.yml.
  host "cd '$dir' && grep -q 'public/brand' docker-compose.yml || { awk '
        /^      - storage_data:\/rails\/storage/ {
          print; print \"      # His own sign-in picture. Read by the minimal layout.\";
          print \"      - ./brand:/rails/public/brand:ro\"; next }
        { print }' docker-compose.yml > .compose.new && mv .compose.new docker-compose.yml; }"
  host "cd '$dir' && grep -q '^ADMIN_LOGIN_IMAGE=' .env || echo 'ADMIN_LOGIN_IMAGE=/brand/admin_login.png' >> .env"

  # RAILS_SERVE_STATIC_FILES, without which the whole thing fails silently.
  #
  # The picture is a plain file under public/, not an asset-pipeline asset, so
  # Rails only serves it when this is on. nginx on this box proxies everything to
  # Rails and has no static location of its own, so there is no second chance.
  #
  # Measured on 15 Sep rather than assumed, because the symptom is not an error:
  #   this box   RAILS_SERVE_STATIC_FILES unset,  /robots.txt -> 404
  #   the estate box, where the seven shops DO show their picture:
  #              RAILS_SERVE_STATIC_FILES=true,   /brand/admin_login.png -> 200
  # Without it the sign-in page renders a broken panel and still answers 200,
  # which reads as "the picture was never sent" and sends everyone back to look
  # for a lost file.
  host "cd '$dir' && grep -q '^RAILS_SERVE_STATIC_FILES=' .env || echo 'RAILS_SERVE_STATIC_FILES=true' >> .env"
  host "cd '$dir' && grep -q '^RAILS_SERVE_STATIC_FILES=true' .env" \
    || die "RAILS_SERVE_STATIC_FILES is not true in $dir/.env. The picture would 404."

  # Prove the compose file actually gained the mount rather than trusting the awk.
  host "cd '$dir' && grep -q 'public/brand' docker-compose.yml" \
    || die "the mount was not added to docker-compose.yml. Look at $dir/docker-compose.yml before rerunning."
  ok "mount and ADMIN_LOGIN_IMAGE are in place"

  warn "the web container must be recreated to see the new mount and variable:"
  info "  script/commercial run \"cd $dir && docker compose up -d web\""
}

cmd_status() {
  host 'for d in /srv/*/; do
      n=$(basename "$d")
      [ -f "$d/docker-compose.yml" ] || { printf "  %-24s not deployed\n" "$n"; continue; }
      rev=$(cat "$d/app/REVISION" 2>/dev/null | cut -c1-7)
      st=$(cd "$d" && docker compose ps web --format "{{.State}}/{{.Health}}" 2>/dev/null | head -1)
      printf "  %-24s %-22s rev %s\n" "$n" "${st:-down}" "${rev:-?}"
    done'
}

case "${1:-help}" in
  survey)  shift; cmd_survey "$@" ;;
  prepare) shift; cmd_prepare "$@" ;;
  ship)    shift; cmd_ship "$@" ;;
  up)      shift; cmd_up "$@" ;;
  nginx)   shift; cmd_nginx "$@" ;;
  admin_image) shift; cmd_admin_image "$@" ;;
  status)  shift; cmd_status "$@" ;;
  ssh)     shift; exec ssh -i "$KEY" -p "$COMMERCIAL_PORT" "$COMMERCIAL_USER@$COMMERCIAL_HOST" ;;
  run)     shift; host "$@" ;;
  *) sed -n '3,10p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
