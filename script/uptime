#!/usr/bin/env node
// Check every deployed shop from OUTSIDE the server, and say what is wrong.
//
//   script/uptime                 check once, exit non-zero if anything is down
//   script/uptime --watch         check every 5 minutes until killed
//   script/uptime --json          machine-readable, for a cron that pipes somewhere
//
// Runs from wherever you run it, deliberately. A monitor installed on the server it
// watches reports nothing at all when that server is the thing that died, which is
// the only moment it was needed. This one is only as reliable as the machine running
// it, so treat it as a working check rather than as a pager.
//
// Targets come from the server itself, read from each /srv/<shop>/.env, so a shop
// added later is watched without editing this file. Nothing about the client is
// hardcoded here: this repo is public.

import { execFileSync } from 'node:child_process'
import { existsSync, readFileSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'
import { connect } from 'node:tls'

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..')
const ENV_PATH = join(ROOT, '.env.commercial')
const WATCH = process.argv.includes('--watch')
const JSON_OUT = process.argv.includes('--json')
const INTERVAL = Number(process.env.UPTIME_INTERVAL || 300) * 1000

// Certificates last 90 days and certbot renews at 30. Anything under 14 means a
// renewal has been failing quietly for a fortnight.
const CERT_WARN_DAYS = 14

const C = process.stdout.isTTY && !JSON_OUT
  ? { dim: '\x1b[2m', red: '\x1b[31m', green: '\x1b[32m', yellow: '\x1b[33m', bold: '\x1b[1m', off: '\x1b[0m' }
  : { dim: '', red: '', green: '', yellow: '', bold: '', off: '' }

const die = (m) => { console.error(`${C.red}error${C.off} ${m}`); process.exit(1) }

function env() {
  if (!existsSync(ENV_PATH)) die(`missing ${ENV_PATH}`)
  const out = {}
  for (const line of readFileSync(ENV_PATH, 'utf8').split('\n')) {
    const m = line.match(/^\s*([A-Z_]+)\s*=\s*(.*)$/)
    if (m) out[m[1]] = m[2].trim().replace(/^["']|["']$/g, '')
  }
  return out
}
const E = env()
const KEY = (E.COMMERCIAL_KEY || '').replace(/^~/, process.env.HOME)

// ── what to watch ───────────────────────────────────────────────────────────

function discover() {
  const script = `for d in /srv/*/; do
      [ -f "$d/.env" ] || continue
      s=$(basename "$d")
      b=$(grep -E '^RAILS_HOST=' "$d/.env" | cut -d= -f2-)
      f=$(grep -E '^STOREFRONT_URL=' "$d/.env" | cut -d= -f2- | sed -E 's|^https?://||; s|/.*$||')
      echo "$s|$b|$f"
    done`
  let raw
  try {
    raw = execFileSync('ssh', ['-i', KEY, '-p', E.COMMERCIAL_PORT || '22', '-o', 'BatchMode=yes',
      '-o', 'ConnectTimeout=15', `${E.COMMERCIAL_USER}@${E.COMMERCIAL_HOST}`, script], { encoding: 'utf8' })
  } catch (e) {
    die(`cannot reach the server to list shops: ${e.message.split('\n')[0]}`)
  }
  const targets = []
  for (const line of raw.trim().split('\n').filter(Boolean)) {
    const [shop, backend, storefront] = line.split('|')
    // /up is Rails' health endpoint. The storefront has no equivalent, so its own
    // home page is the check: it is what a customer would hit anyway.
    if (backend) targets.push({ shop, role: 'admin', url: `https://${backend}/up` })
    if (storefront) targets.push({ shop, role: 'shop', url: `https://${storefront}/` })
  }
  return targets
}

// ── checks ──────────────────────────────────────────────────────────────────

async function httpCheck(url) {
  const started = Date.now()
  try {
    const res = await fetch(url, { redirect: 'follow', signal: AbortSignal.timeout(20_000) })
    return { ok: res.ok, status: res.status, ms: Date.now() - started }
  } catch (e) {
    return { ok: false, status: 0, ms: Date.now() - started, error: e.message.split('\n')[0].slice(0, 60) }
  }
}

// Read the certificate off the socket rather than trusting the HTTP call. A page can
// answer perfectly today on a certificate that expires on Sunday.
function certDays(host) {
  return new Promise((resolve) => {
    const socket = connect({ host, port: 443, servername: host, timeout: 15_000 }, () => {
      const cert = socket.getPeerCertificate()
      socket.end()
      if (!cert || !cert.valid_to) return resolve(null)
      resolve(Math.floor((new Date(cert.valid_to) - Date.now()) / 86_400_000))
    })
    socket.on('error', () => resolve(null))
    socket.on('timeout', () => { socket.destroy(); resolve(null) })
  })
}

async function runOnce(targets) {
  const results = []
  for (const t of targets) {
    const host = new URL(t.url).hostname
    const [http, days] = await Promise.all([httpCheck(t.url), certDays(host)])
    results.push({ ...t, ...http, certDays: days })
  }
  return results
}

// ── report ──────────────────────────────────────────────────────────────────

function report(results) {
  if (JSON_OUT) {
    // No Date.now() in the payload beyond this stamp, so a diff between two runs
    // shows only what actually changed.
    console.log(JSON.stringify({ checked_at: new Date().toISOString(), results }, null, 2))
  } else {
    for (const r of results) {
      const bad = !r.ok
      const certBad = r.certDays !== null && r.certDays < CERT_WARN_DAYS
      const mark = bad ? `${C.red}DOWN${C.off}` : certBad ? `${C.yellow}cert${C.off}` : `${C.green}ok  ${C.off}`
      const cert = r.certDays === null ? 'cert ?' : `cert ${r.certDays}d`
      console.log(`  ${mark} ${String(r.shop).padEnd(20)} ${r.role.padEnd(5)} ` +
        `${String(r.status || r.error || '').padEnd(24)} ${String(r.ms + 'ms').padStart(7)}  ${cert}`)
    }
  }
  const down = results.filter((r) => !r.ok)
  const expiring = results.filter((r) => r.certDays !== null && r.certDays < CERT_WARN_DAYS)
  return { down, expiring }
}

// ── run ─────────────────────────────────────────────────────────────────────

const targets = discover()
if (!targets.length) die('no shops found on the server')

if (!WATCH) {
  const { down, expiring } = report(await runOnce(targets))
  if (!JSON_OUT && !down.length && !expiring.length) {
    console.log(`${C.dim}  ${targets.length} endpoint(s), all answering${C.off}`)
  }
  process.exit(down.length || expiring.length ? 1 : 0)
}

console.log(`${C.dim}watching ${targets.length} endpoint(s) every ${INTERVAL / 1000}s — ctrl-c to stop${C.off}`)
let lastBad = ''
for (;;) {
  const results = await runOnce(targets)
  const { down, expiring } = report(results)
  // Print the full table only when something changes. A watcher that repeats a
  // healthy table every five minutes trains you to stop reading it.
  const nowBad = [...down, ...expiring].map((r) => `${r.shop}/${r.role}`).sort().join(',')
  if (nowBad !== lastBad) {
    console.log(`${C.bold}${new Date().toISOString().slice(0, 19)}${C.off} ` +
      (nowBad ? `${C.red}problem: ${nowBad}${C.off}` : `${C.green}everything recovered${C.off}`))
    lastBad = nowBad
  }
  await new Promise((r) => setTimeout(r, INTERVAL))
}
