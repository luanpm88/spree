#!/usr/bin/env bash
#
# Every shop lets a customer say something about their order.
#
#   script/check_note_box
#   script/check_note_box nolocal
#
# ── why this is a gate and not a one-off fix ────────────────────────────────
#
# The old shop had a message box at checkout. The new one did not, and nobody
# noticed until a customer wanted it. One real order still carries what somebody
# typed into the old one, on 12 Aug:
#
#   "Call before arriving. Courier must use the Waze app to find the address"
#
# That is an instruction for whoever packs and delivers the parcel. With no field
# it has nowhere to go, and the shop finds out when a delivery goes wrong.
#
# The shop owner asked for it back on every shop and asked that it stay:
# "Please add back the message box on checkout to all shops and make this a
# requirement for all shops going forward. I think this one is very important."
#
# A requirement that lives in a chat message is a requirement until the next
# rebuild. This is the same requirement, written where a build can fail on it.
#
# ── what it checks, and why it opens a browser to do it ─────────────────────
#
# The field is React, rendered client side inside the checkout flow, and it only
# exists once there is a cart. Nothing about that can be seen by fetching HTML,
# so this adds an item, walks to checkout, and looks for the box.
#
# It also checks the box SAVES, because a field that does not persist is worse
# than no field: the customer types their instruction, sees it accepted, and the
# shop never gets it.
set -uo pipefail
cd "$(dirname "$0")/.."

ONLY="${1:-}"

ESTATE_FILE="${ESTATE_FILE:-.estate}"
if [[ ! -f "$ESTATE_FILE" ]]; then
  echo "  no .estate on this machine, cannot map a shop to a host"
  exit 0
fi

# Needed to clean up after the probe, not to run it. The measurement is a browser
# against a public address; the cleanup is a database write and needs the server.
# shellcheck source=/dev/null
[[ -f .estate.env ]] && source .estate.env
CAN_CLEAN=1
[[ -n "${SSH_HOST:-}" && -n "${SSH_KEY:-}" ]] || CAN_CLEAN=0
: "${SSH_PORT:=22}"

if [[ -t 1 ]]; then GR=$'\033[32m'; RE=$'\033[31m'; YE=$'\033[33m'; R=$'\033[0m'
else GR=''; RE=''; YE=''; R=''; fi

# The probe lives in script/, not in a temp directory.
#
# node resolves `playwright` from node_modules by walking up from the FILE, so a
# probe written to /var/folders finds nothing and every shop comes back
# "could not be measured" — which is what the first version of this gate did,
# reporting all seven broken while the box demonstrably worked.
PROBE="script/.notebox_probe.mjs"
trap 'rm -f "$PROBE"' EXIT
cat > "$PROBE" <<'EOF'
import { chromium } from "playwright";
const HOST = process.argv[2];
const EMAIL = process.argv[3] || "";
const PASSWORD = process.argv[4] || "";
const MSG = "check_note_box probe, please ignore";
const b = await chromium.launch();
const p = await b.newPage({ viewport: { width: 1440, height: 1400 } });
const out = (k, v) => console.log(`${k}|${v}`);
try {
  // A closed shop shows a stranger no products at all, so the probe has to sign
  // in before it can reach a checkout. Without this the wholesale shop times out
  // looking for a product link and reads as a missing message box, which is the
  // same mistake as an image count that reads a login form and reports zero
  // photographs.
  if (EMAIL && PASSWORD) {
    await p.goto(`${HOST}/account/login`, { waitUntil: "domcontentloaded", timeout: 90000 }).catch(() => {});
    await p.waitForTimeout(2500);
    await p.fill('input[type="email"], input[name="email"]', EMAIL).catch(() => {});
    await p.fill('input[type="password"], input[name="password"]', PASSWORD).catch(() => {});
    await p.getByRole("button", { name: /log ?in|sign ?in/i }).first().click({ timeout: 15000 }).catch(() => {});
    await p.waitForTimeout(6000);
  }
  await p.goto(HOST, { waitUntil: "domcontentloaded", timeout: 60000 });
  // Waits for a product link rather than three seconds. One of these shops
  // answers /products in sixteen seconds when the box is busy, and a fixed wait
  // there reads as a shop with nothing to sell.
  await p.waitForSelector('a[href*="/products/"]', { timeout: 90000 }).catch(() => {});
  const href = await p.locator('a[href*="/products/"]').first().getAttribute("href");
  if (!href) { out("SKIP", "no product to test with"); await b.close(); process.exit(0); }
  await p.goto(new URL(href, HOST).toString(), { waitUntil: "domcontentloaded", timeout: 60000 });

  // Adding is allowed to fail, because a full cart is not a broken shop.
  //
  // On the wholesale shop the signed-in cart already holds every carton in
  // stock, so the shop correctly refuses another and the click never resolves.
  // The first version read that timeout as a missing message box and failed a
  // shop whose checkout was working perfectly. What this gate needs is A CART,
  // not one more item in it.
  //
  // But it is RETRIED first, which it was not. The button is server rendered, so
  // it is visible and clickable well before React attaches its handler, and a
  // click in that window does nothing at all: no request, no error, no change.
  // check_storefront_e2e.mjs measured that as one success in six. On 3 Sep this
  // gate failed Australia with "could not reach a checkout, stopped at
  // /products/..." while that shop answered 200 everywhere and its checkout was
  // fine — one click, on a page that had taken sixteen seconds to arrive.
  //
  // The retry stops at the cart token cookie, and then carries on either way.
  // It must not become a hard failure: the signed-in wholesale cart is not a
  // guest cart and may carry no such cookie at all.
  const add = p.locator('button:has-text("Add to"), button:has-text("ADD TO")').first();
  await add.waitFor({ state: "visible", timeout: 60000 }).catch(() => {});
  const hasCart = async () =>
    (await p.context().cookies()).some((c) => c.name.startsWith("_spree_cart_token"));
  let tries = 0;
  while (!(await hasCart()) && tries < 4) {
    tries += 1;
    await add.click({ timeout: 15000 }).catch(() => {});
    for (let i = 0; i < 12 && !(await hasCart()); i++) await p.waitForTimeout(250);
  }
  await p.waitForTimeout(2000);

  const toCheckout = p.locator('a[href*="checkout"], button:has-text("Checkout"), a:has-text("Checkout")').first();
  if (await toCheckout.count()) {
    await toCheckout.click({ timeout: 20000 }).catch(() => {});
  } else {
    await p.goto(`${HOST}/cart`, { waitUntil: "domcontentloaded", timeout: 60000 }).catch(() => {});
    await p.waitForTimeout(3000);
    await p.locator('a[href*="checkout"], button:has-text("Checkout")').first().click({ timeout: 20000 }).catch(() => {});
  }
  await p.waitForURL(/\/checkout\//, { timeout: 60000 }).catch(() => {});
  if (!p.url().includes("/checkout")) { out("FAIL", `could not reach a checkout, stopped at ${p.url().slice(0, 60)}`); await b.close(); process.exit(0); }

  // Waits for the box rather than for a number of seconds, so a slow shop is not
  // reported as a shop that has no message box. This gate failed Australia on
  // 3 Sep with "no message box on this checkout" after a fixed nine second wait;
  // that shop was answering /products in sixteen seconds and its box was there.
  // A box that genuinely does not exist still fails, one line below.
  await p.waitForSelector("#checkout-customer-note", { timeout: 90000 }).catch(() => {});

  const box = p.locator("#checkout-customer-note");
  if ((await box.count()) === 0) { out("FAIL", "no message box on this checkout"); await b.close(); process.exit(0); }

  const bb = await box.boundingBox();
  if (!bb || bb.height < 20) { out("FAIL", "the box is on the page but not visible"); await b.close(); process.exit(0); }

  // It has to SAVE. Typed, blurred, reloaded, read back.
  //
  // Scrolled so the message box sits at the BOTTOM of the window, not the
  // middle, which keeps the payment section below the fold.
  //
  // Since 3 Sep a Stripe payment intent is created when the payment box enters
  // the window, and the payment section sits directly under this one. Centring
  // this box brought it into view, so this gate was minting an intent on every
  // shop on every run. Measured on Canada right after the change: 45 sessions
  // before, 47 after. Two, because the browser restores the scroll position on
  // reload and the read-back pass did it again.
  //
  // The shop owner's complaint was 549 rows in his dashboard, a good share of
  // them ours. Fixing the shop and leaving this would have handed him back a
  // quieter version of the same thing.
  // `end` alone was not enough: it leaves the payment box 24px below the fold,
  // and the express checkout button above hides itself once Stripe reports no
  // wallet, which shortens the page and pulls payment up into view. Measured
  // that way round, 2 intents per run became 1 after the reload was fixed and
  // this one remained. The extra 180px is headroom for that shift.
  await box.evaluate((el) => {
    el.scrollIntoView({ block: "end" });
    window.scrollBy(0, -180);
  });
  await box.fill(MSG);
  // Blurred in place and then straight back to the top, rather than blurred by
  // clicking a heading. Playwright scrolls whatever it clicks into view, and
  // every extra second spent parked beside the payment section is another
  // chance for it to enter the window and mint a Stripe intent. Blur is what
  // saves the note, so it still has to happen; it just does not have to be a
  // click somewhere else on the page.
  await box.evaluate((el) => el.blur());
  await p.evaluate(() => window.scrollTo(0, 0));
  await p.waitForTimeout(6000);
  // Back to the top before reloading, because the browser restores the scroll
  // position and would land the reloaded page next to the payment box, which is
  // a second Stripe intent for the same reason as the first.
  await p.evaluate(() => window.scrollTo(0, 0));
  await p.waitForTimeout(500);
  await p.reload({ waitUntil: "domcontentloaded", timeout: 60000 });
  // Same again after the reload: the read-back has to wait for the field to come
  // back, or a slow shop reads as a shop that did not save.
  await p.waitForSelector("#checkout-customer-note", { timeout: 90000 }).catch(() => {});
  await p.waitForTimeout(2000);
  const kept = await p.locator("#checkout-customer-note").inputValue().catch(() => "");
  if (kept.trim() !== MSG) { out("FAIL", `typed but did not persist, read back "${kept.slice(0, 40)}"`); await b.close(); process.exit(0); }
  // The marker is LEFT IN PLACE on purpose. Do not add a clearing step here.
  //
  // The shell removes the whole order afterwards, and it finds it by this exact
  // sentence. That is the only identifier that cannot be confused with a real
  // shopper: on the wholesale shop the probe signs in as the owner, so the order
  // it creates carries HIS user id, and every guest-shaped guard correctly
  // refuses to touch it.
  //
  // An earlier version cleared the text instead and was believed to be clean.
  // It was not: walking to a checkout moves the order from `cart` to `address`,
  // so each run left a draft order behind on every shop. They accumulated until
  // the client opened Draft Orders, saw a column of N/A customers and asked
  // whether something was broken. Deleting the order removes the text with it,
  // which clearing never did the other way round.
  out("OK", `${Math.round(bb.width)}x${Math.round(bb.height)}, saved and read back`);
} catch (e) {
  out("FAIL", e.message.slice(0, 90));
}
await b.close();
EOF

bad=0
checked=0

while IFS='|' read -r shop _dir _db _port _sport tmp _store live _rest; do
  [[ -n "$shop" ]] || continue
  case "$shop" in \#*) continue;; esac
  [[ -z "$ONLY" || "$ONLY" == "$shop" ]] || continue

  host="${live// /}"
  [[ -n "$host" && "$host" != "-" ]] || host="https://${tmp// /}"
  [[ "$host" == http* ]] || host="https://$host"
  [[ "$host" != "https://" && "$host" != "https://-" ]] || continue

  # Credentials only for a shop listed as closed, and only if .shopauth has them.
  email=""; password=""
  if [[ -f config/gated_shops ]] && grep -qx "$shop" config/gated_shops 2>/dev/null; then
    if [[ -f .shopauth ]]; then
      up=$(printf '%s' "$shop" | tr '[:lower:]' '[:upper:]')
      email=$(grep -E "^${up}_EMAIL=" .shopauth 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"')
      password=$(grep -E "^${up}_PASSWORD=" .shopauth 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"')
    fi
    if [[ -z "$email" || -z "$password" ]]; then
      printf '  %-10s %sclosed shop and no credentials in .shopauth, not measured%s\n' "$shop" "$YE" "$R"
      continue
    fi
  fi

  # One retry before a red.
  #
  # Seven browser sessions in a row against one box makes the last of them slow,
  # and a click that waits 20s on a busy shop is not a missing field. b2b passed
  # on its own and timed out inside the full run, which is exactly the shape of a
  # false red. Every false red on this project has cost more than the fault it
  # claimed, so a timeout is asked once more, on a quieter shop, before it counts.
  line=$(node "$PROBE" "$host" "$email" "$password" 2>/dev/null | grep -E '^(OK|FAIL|SKIP)\|' | head -1)
  if [[ "${line%%|*}" == "FAIL" && "$line" == *Timeout* ]]; then
    sleep 8
    line=$(node "$PROBE" "$host" "$email" "$password" 2>/dev/null | grep -E '^(OK|FAIL|SKIP)\|' | head -1)
  fi
  # Remove the order the probe just created.
  #
  # Clearing the TEXT was not enough, and believing it was is what made this a
  # problem the client had to report. Walking to a checkout moves the order from
  # `cart` to `address`, so every run of this gate left a draft order behind on
  # every shop, and they accumulated: 24 of them across five shops by 1 Sep. He
  # opened Draft Orders, saw a column of "N/A" customers, and asked whether
  # something was broken. Nothing was broken. He was looking at our probe.
  #
  # TWO shapes, because the probe leaves two.
  #
  # 1. The order it typed into. Found by the exact sentence and nothing else:
  #    an equality test cannot spread the way a LIKE can, and a cleanup here once
  #    matched a real customer order with `%Waze app%` because the pattern was a
  #    fragment. No guest condition on this one: on the closed shop the probe signs
  #    in as the owner, so its order carries his user id and a guest-shaped guard
  #    would skip the shop where rubbish in a cart matters most.
  #
  # 2. The order it NEVER GOT TO TYPE INTO. This is the one that was missed, and
  #    the client's Draft Orders screen is where it showed up. A run that reaches
  #    the checkout and then fails, times out, or is interrupted has already moved
  #    its order from `cart` to `address`, and it carries no marker because nothing
  #    was ever typed. Seventeen of those were left across five shops on 1 Sep by
  #    runs made before this cleanup existed, and the first sweep did not see them
  #    because it looked only for shape 1.
  #
  #    Guarded by the fact a real shopper cannot be in that state: getting past
  #    `cart` is what entering an email does. So no email AND not `cart` AND guest
  #    AND minutes old is the probe and cannot be a customer.
  #
  # Both are bounded to the last 30 minutes, so a sweep can only ever remove what
  # this run itself made.
  #
  # If the delete somehow leaves anything, the text is blanked as a fallback so a
  # failure here can never end with the probe's words sitting in a live cart.
  cleaned=0
  [[ "$CAN_CLEAN" == 1 ]] && cleaned=$(ssh -n -i "$SSH_KEY" -p "$SSH_PORT" -o BatchMode=yes "$SSH_HOST" \
    "docker exec ${shop}_web bin/rails runner '
       marker = %q{check_note_box probe, please ignore}
       recent = 30.minutes.ago
       typed = Spree::Order.where(completed_at: nil, special_instructions: marker)
                           .where(%q{created_at > ?}, recent)
       # Reached the checkout and never got as far as the box.
       untyped = Spree::Order.where(completed_at: nil, email: nil, user_id: nil)
                             .where.not(state: %q{cart})
                             .where(%q{created_at > ?}, recent)
       scope = Spree::Order.where(id: typed.select(:id)).or(Spree::Order.where(id: untyped.select(:id)))
       gone = 0
       scope.to_a.each do |o|
         id = o.id
         Spree::Order.transaction do
           o.destroy
           raise ActiveRecord::Rollback if Spree::Order.exists?(id: id)
         end
         gone += 1 unless Spree::Order.exists?(id: id)
       end
       left = Spree::Order.where(completed_at: nil, special_instructions: marker)
       left.update_all(special_instructions: nil) if left.exists?
       print %q{<<C:} + gone.to_s + %q{:C>>}
     ' 2>/dev/null" 2>/dev/null | tr -d '\r' | sed -n 's/.*<<C:\(.*\):C>>.*/\1/p')

  verdict="${line%%|*}"; detail="${line#*|}"
  [[ "${cleaned:-0}" -gt 0 ]] && detail="$detail, cleaned up after itself"
  case "$verdict" in
    OK)   checked=$((checked + 1)); printf '  %-10s %sok%s   %s\n' "$shop" "$GR" "$R" "$detail" ;;
    SKIP) printf '  %-10s %s%s%s\n' "$shop" "$YE" "$detail" "$R" ;;
    *)    checked=$((checked + 1)); bad=$((bad + 1))
          printf '  %-10s %s%s%s\n' "$shop" "$RE" "${detail:-could not be measured}" "$R" ;;
  esac
done < <(grep -vE '^\s*(#|$)' "$ESTATE_FILE" | grep -v '^LIVE_DOMAINS=')

echo
if [[ $bad -gt 0 ]]; then
  cat >&2 <<EOF
${RE}FAILED${R}: $bad of $checked shop(s) have no working message box at checkout.

The customer has nowhere to tell you about their delivery. The field is
CustomerNote in components/checkout, saved through updateCustomerNote in
lib/data/checkout, and it writes customer_note, which is what the Store API
permits. Sending special_instructions instead is dropped in silence.
EOF
  exit 1
fi
echo "  ${GR}ok${R} — $checked shop(s), each with a message box that saves"
