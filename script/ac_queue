#!/usr/bin/env python3
"""
Post tracker comments later, spaced out, instead of the moment they are written.

    script/ac_queue add 15 draft.md --as huy --project 1 [--attach report.pdf] [--off-assignment] [--not-before 14:30] [--urgent] [--label FIXED]
    script/ac_queue task --project 1 --as luan --title "Title" --body draft.md [--list "Task list"] [--assignee <name>] [--not-before 14:30] [--urgent]
                                         create a new tracker task at its slot (script/ac_task_create), spaced like a comment
    script/ac_queue label 17 FIXED --as huy --project 1 [--not-before 09:30]
                                         set a task's status label in office hours, with no comment (script/ac_label);
                                         labels notify nobody, so they take no slot and push nothing back
    script/ac_queue like <comment id> <task id> --as luan|huy [--not-before 14:30]
                                         thumbs up a client comment at its slot (script/ac_like), spaced like a comment:
                                         a like is an action on the tracker too, and from two accounts on one machine
                                         it must not land minutes after the other account's post (Luan, 23 Nov 2026)
    script/ac_queue move <id> 10:05      move one waiting job to a time (then everything is re-spaced as usual)
    script/ac_queue try <id>             rehearse one job now: its preview, exactly as the real run would call it; changes nothing
    script/ac_queue list                 what is waiting, and when each one goes
    script/ac_queue run                  post the one comment that is due (launchd runs this every 5 minutes)
    script/ac_queue cancel <id>          take one out, nothing posted
    script/ac_queue release <id>         post a held one at the next slot after all
    script/ac_queue reflow               re-space what is waiting under the current rules (after changing them)
    script/ac_queue install              load the launchd job (once)

Why: on 11 Nov 2026 Huy posted four comments in four minutes (22:01 to 22:04), and on 12 Nov Luan
posted five in the same minute (13:39) with Huy's three following at 13:45, 13:47 and 13:50.
Luan: "làm thì cứ làm, việc comment hay phản hồi thì nhớ dãn cách auto chạy ko nhất thiết làm ngay",
and Luan and Huy must never post so close together that it shows. So the work is done at once
and the comments wait here.

The rules, for every account together:
  * the first one goes 10 to 35 minutes after it is queued, never at once;
  * any two posts, whoever writes them, are 25 to 70 minutes apart, the gap drawn at random;
  * only in office hours on this laptop's clock: Monday to Friday, 08:15 to 12:00 and 13:00 to
    17:00. A slot outside moves to the next opening plus up to 45 minutes: lunch to 13:00, the
    evening to the next working morning, a weekend to Monday. Luan, 17 Nov 2026, after the queue
    had planned two comments for 17:50 and 18:40: "nhớ đăng trong giờ hành chính nha, mình nguyên
    tắc là ko ngoài giờ, tất nhiên trừ khi cần". The window was 08:15 to 22:00, every day;
  * --urgent is the "trừ khi cần": that one comment may go at any hour on any day. It is still
    spaced from the others and still held on a new comment. One that must go this minute is not
    queued at all: Luan asks, and it is posted with ac_comment --send;
  * one post per run, and after each post the rest are pushed back if a laptop that slept has
    left them bunched up;
  * a reply is held, not posted, when someone else has commented on that task since it was queued
    (ac_comment --hold-if-new-since), because it may answer a question that has moved on.

--label sets the task's status label (script/ac_label) right after its comment is posted, from the
same account, so the client sees the task marked done the moment the reply that says so arrives
(Luan, 17 Nov 2026: "Luan Huy chủ động đánh dấu cái nào xong"). It is checked when the
comment is queued and set only once the comment is up; a label that fails is logged and notified,
and the comment stands.

Every post goes through script/ac_comment, so its account check (--as against the token), the
assignee lock and the read-back of the author all still apply. `add` runs it as a dry run first
and refuses to queue a comment that would not post. Nothing here bypasses the preview: the
preview is printed when the comment is queued, and the queue is the decision to send it.
"""
import datetime as dt, fcntl, json, os, pathlib, random, re, shutil, subprocess, sys, time

ROOT = pathlib.Path(__file__).resolve().parent.parent
Q = ROOT / 'tmp' / 'ac_queue'
STATE = Q / 'state.json'
LOG = Q / 'log.txt'
ENV_FOR = {'luan': '.env.ac_team', 'huy': '.env.ac_huy'}
FIRST = (10, 35)            # minutes after queueing
GAP = (25, 70)              # minutes between any two posts
HOURS = (((8, 15), (12, 0)), ((13, 0), (17, 0)))   # office hours, local clock, Monday to Friday
WORKDAYS = range(0, 5)      # datetime.weekday(): Monday 0 to Friday 4
OPEN_JITTER = 45            # minutes after an opening that a moved slot may land
PLIST = pathlib.Path.home() / 'Library/LaunchAgents/com.luan.spree.ac-queue.plist'
rng = random.SystemRandom()


def log(msg):
    Q.mkdir(parents=True, exist_ok=True)
    line = f'{dt.datetime.now():%Y-%m-%d %H:%M:%S} {msg}'
    with LOG.open('a') as f:
        f.write(line + '\n')
    print(line)


def notify(msg):
    subprocess.run(['osascript', '-e', f'display notification {json.dumps(msg)} with title "ac_queue"'], capture_output=True)


def state():
    return json.loads(STATE.read_text()) if STATE.exists() else {'last_post': 0}


def save_state(s):
    STATE.write_text(json.dumps(s, indent=2))


def jobs(status=None):
    out = []
    for p in sorted(Q.glob('*/job.json')):
        j = json.loads(p.read_text())
        j['_dir'] = p.parent
        if status is None or j['status'] in status:
            out.append(j)
    return sorted(out, key=lambda j: (j['due'], j['id']))


def save(j):
    d = j.pop('_dir')
    (d / 'job.json').write_text(json.dumps(j, indent=2))
    j['_dir'] = d


def next_open(t):
    """(opening, inside): the start of the office-hours window t falls in, or of the next one."""
    d = dt.datetime.fromtimestamp(t)
    midnight = d.replace(hour=0, minute=0, second=0, microsecond=0)
    for i in range(8):
        day = midnight + dt.timedelta(days=i)
        if day.weekday() not in WORKDAYS:
            continue
        for (h0, m0), (h1, m1) in HOURS:
            start, end = day.replace(hour=h0, minute=m0), day.replace(hour=h1, minute=m1)
            if d <= end:
                return start.timestamp(), d >= start
    raise SystemExit('ac_queue: no office hours in the next week; check HOURS and WORKDAYS')


def open_now(t):
    return next_open(t)[1]


def in_day(t, urgent=False):
    """The same moment if it is inside office hours (or the job is urgent), else the next opening plus jitter."""
    opening, inside = next_open(t)
    if urgent or inside:
        return t
    return opening + rng.randint(0, OPEN_JITTER * 60)


def gap():
    return rng.randint(GAP[0] * 60, GAP[1] * 60)


def reflow(now=None):
    """Space every waiting job after the last post and after each other; keep each one's not-before."""
    now = now or time.time()
    prev = max(state()['last_post'], 0)
    for j in jobs({'queued'}):
        urgent = j.get('urgent', False)
        if j.get('kind') == 'label':
            # A label notifies nobody, so it keeps its own time, only moved into office hours.
            want = in_day(max(j['due'], j['not_before']), urgent)
            if want != j['due']:
                j['due'] = want
                save(j)
            continue
        # A job already at least the shortest gap after the one before keeps its time. Drawing a new
        # random gap on every pass pushed jobs later each time anything was posted, added or moved
        # (17 Nov 2026: a reply planned for 09:15 drifted to 15:23 over one evening). The random gap
        # is drawn only when a job has to move.
        floor = max(j['not_before'], now + 60, prev + GAP[0] * 60 if prev else 0)
        if j['due'] < floor:
            j['due'] = in_day(max(floor, prev + gap() if prev else 0), urgent)
            save(j)
        elif in_day(j['due'], urgent) != j['due']:
            j['due'] = in_day(j['due'], urgent)
            save(j)
        prev = j['due']


def ac_args(j):
    a = ['node', str(ROOT / 'script/ac_comment'), str(j['task']), str(j['_dir'] / 'draft.md'),
         '--env', j['env'], '--project', str(j['project']), '--as', j['as']]
    for f in j['attach']:
        a += ['--attach', str(j['_dir'] / f)]
    if j.get('off_assignment'):
        a.append('--off-assignment')
    return a


def task_args(j):
    a = ['node', str(ROOT / 'script/ac_task_create'), '--project', str(j['project']), '--as', j['as'], '--env', j['env'],
         '--title', j['title'], '--body', str(j['_dir'] / 'draft.md')]
    if j.get('list'):
        a += ['--list', j['list']]
    if j.get('assignee'):
        a += ['--assignee', j['assignee']]
    return a


def label_args(j):
    a = ['node', str(ROOT / 'script/ac_label'), str(j['task']), j['label'], '--as', j['as'], '--project', str(j['project']), '--env', j['env']]
    if j.get('off_assignment'):
        a.append('--off-assignment')
    return a


def like_args(j):
    return ['node', str(ROOT / 'script/ac_like'), str(j['comment']), str(j['task']), '--as', j['as']]


def parse_when(s):
    now = dt.datetime.now()
    for fmt in ('%H:%M', '%Y-%m-%d %H:%M'):
        try:
            t = dt.datetime.strptime(s, fmt)
        except ValueError:
            continue
        if fmt == '%H:%M':
            t = now.replace(hour=t.hour, minute=t.minute, second=0)
            if t < now:
                t += dt.timedelta(days=1)
        return t.timestamp()
    sys.exit(f'--not-before: use HH:MM or "YYYY-MM-DD HH:MM", not {s!r}')


def take(argv, name, many=False, boolean=False):
    vals = []
    while name in argv:
        i = argv.index(name)
        if boolean:
            argv.pop(i)
            return True
        vals.append(argv[i + 1])
        del argv[i:i + 2]
    if boolean:
        return False
    return vals if many else (vals[0] if vals else None)


def cmd_add(argv):
    who = take(argv, '--as')
    project = take(argv, '--project')
    attach = take(argv, '--attach', many=True)
    off = take(argv, '--off-assignment', boolean=True)
    not_before = take(argv, '--not-before')
    urgent = take(argv, '--urgent', boolean=True)
    label = take(argv, '--label')
    env = take(argv, '--env') or ENV_FOR.get(who or '')
    if who not in ENV_FOR or not project or len(argv) != 2:
        sys.exit('usage: script/ac_queue add <task> <draft.md> --as luan|huy --project <id> [--attach f]… [--off-assignment] [--not-before HH:MM] [--urgent] [--label FIXED]')
    task, draft = argv
    for f in [draft, *attach]:
        if not pathlib.Path(f).is_file():
            sys.exit(f'no such file: {f}')

    now = time.time()
    jid = f'{dt.datetime.now():%m%d-%H%M%S}-{who}-{task}'
    d = Q / jid
    d.mkdir(parents=True)
    shutil.copy(draft, d / 'draft.md')
    for f in attach:
        shutil.copy(f, d / pathlib.Path(f).name)
    j = {'id': jid, 'task': task, 'project': project, 'as': who, 'env': env, 'attach': [pathlib.Path(f).name for f in attach],
         'off_assignment': off, 'source': str(pathlib.Path(draft).resolve()), 'queued_at': int(now),
         'not_before': parse_when(not_before) if not_before else 0, 'urgent': urgent, 'label': label.upper() if label else None,
         'status': 'queued', '_dir': d}
    j['due'] = in_day(max(now + rng.randint(FIRST[0] * 60, FIRST[1] * 60), j['not_before']), urgent)

    # The same checks as a real post, now, so a comment that would be refused never waits for hours.
    r = subprocess.run(ac_args(j), cwd=ROOT, capture_output=True, text=True)
    print(r.stdout, end='')
    if r.returncode != 0:
        shutil.rmtree(d)
        sys.exit(f'not queued: ac_comment refused it\n{r.stderr}')
    if j['label']:
        r = subprocess.run(label_args(j), cwd=ROOT, capture_output=True, text=True)
        print(r.stdout, end='')
        if r.returncode != 0:
            shutil.rmtree(d)
            sys.exit(f'not queued: ac_label refused the label {j["label"]}\n{r.stderr}')
    save(j)
    reflow(now)
    j = next(x for x in jobs() if x['id'] == jid)
    log(f'queued {jid}: task #{task} as {who}, goes at {dt.datetime.fromtimestamp(j["due"]):%a %H:%M}'
        + (' (urgent: office hours do not apply)' if urgent else ''))


def new_job(who, project, task, kind, not_before, urgent, env, extra):
    now = time.time()
    jid = f'{dt.datetime.now():%m%d-%H%M%S}-{who}-{task}'
    d = Q / jid
    d.mkdir(parents=True)
    j = {'id': jid, 'kind': kind, 'task': task, 'project': project, 'as': who, 'env': env, 'attach': [],
         'off_assignment': False, 'queued_at': int(now), 'not_before': parse_when(not_before) if not_before else 0,
         'urgent': urgent, 'label': None, 'status': 'queued', '_dir': d, **extra}
    return j, d, now


def cmd_task(argv):
    who = take(argv, '--as')
    project = take(argv, '--project')
    title = take(argv, '--title')
    body = take(argv, '--body')
    lst = take(argv, '--list')
    assignee = take(argv, '--assignee')
    not_before = take(argv, '--not-before')
    urgent = take(argv, '--urgent', boolean=True)
    env = take(argv, '--env') or ENV_FOR.get(who or '')
    if who not in ENV_FOR or not project or not title or not body or argv:
        sys.exit('usage: script/ac_queue task --project <id> --as luan|huy --title "Title" --body draft.md [--list "Task list"] [--assignee name] [--not-before HH:MM] [--urgent]')
    if not pathlib.Path(body).is_file():
        sys.exit(f'no such file: {body}')
    j, d, now = new_job(who, project, 'new', 'task', not_before, urgent, env,
                        {'title': title, 'list': lst, 'assignee': assignee, 'source': str(pathlib.Path(body).resolve())})
    shutil.copy(body, d / 'draft.md')
    j['due'] = in_day(max(now + rng.randint(FIRST[0] * 60, FIRST[1] * 60), j['not_before']), urgent)
    r = subprocess.run(task_args(j), cwd=ROOT, capture_output=True, text=True)
    print(r.stdout, end='')
    if r.returncode != 0:
        shutil.rmtree(d)
        sys.exit(f'not queued: ac_task_create refused it\n{r.stderr}')
    save(j)
    reflow(now)
    j = next(x for x in jobs() if x['id'] == j['id'])
    log(f'queued {j["id"]}: new task "{title}" as {who}, goes at {dt.datetime.fromtimestamp(j["due"]):%a %H:%M}'
        + (' (urgent: office hours do not apply)' if urgent else ''))


def cmd_label(argv):
    who = take(argv, '--as')
    project = take(argv, '--project')
    not_before = take(argv, '--not-before')
    off = take(argv, '--off-assignment', boolean=True)
    env = take(argv, '--env') or ENV_FOR.get(who or '')
    if who not in ENV_FOR or not project or len(argv) != 2:
        sys.exit('usage: script/ac_queue label <task> <LABEL> --as luan|huy --project <id> [--not-before HH:MM] [--off-assignment]')
    task, label = argv
    j, d, now = new_job(who, project, task, 'label', not_before, False, env, {'label': label.upper(), 'off_assignment': off})
    j['due'] = in_day(max(now + rng.randint(FIRST[0] * 60, FIRST[1] * 60), j['not_before']))
    r = subprocess.run(label_args(j), cwd=ROOT, capture_output=True, text=True)
    print(r.stdout, end='')
    if r.returncode != 0:
        shutil.rmtree(d)
        sys.exit(f'not queued: ac_label refused it\n{r.stderr}')
    save(j)
    log(f'queued {j["id"]}: label {j["label"]} on task #{task} as {who}, goes at {dt.datetime.fromtimestamp(j["due"]):%a %H:%M}')


def cmd_like(argv):
    who = take(argv, '--as')
    not_before = take(argv, '--not-before')
    urgent = take(argv, '--urgent', boolean=True)
    env = ENV_FOR.get(who or '')
    if who not in ENV_FOR or len(argv) != 2 or not all(a.isdigit() for a in argv):
        sys.exit('usage: script/ac_queue like <comment id> <task id> --as luan|huy [--not-before HH:MM] [--urgent]')
    comment, task = argv
    j, d, now = new_job(who, '-', task, 'like', not_before, urgent, env, {'comment': int(comment)})
    j['due'] = in_day(max(now + rng.randint(FIRST[0] * 60, FIRST[1] * 60), j['not_before']), urgent)
    # The dry run refuses the wrong account, a comment not on that task, one not by the client,
    # and one this account already liked, so a bad like never waits in the queue.
    r = subprocess.run(like_args(j), cwd=ROOT, capture_output=True, text=True)
    print(r.stdout, end='')
    if r.returncode != 0 or 'would like' not in r.stdout:
        shutil.rmtree(d)
        sys.exit(f'not queued: ac_like refused it\n{r.stdout}{r.stderr}')
    save(j)
    reflow(now)
    j = next(x for x in jobs() if x['id'] == j['id'])
    log(f'queued {j["id"]}: like comment {comment} on task id {task} as {who}, goes at {dt.datetime.fromtimestamp(j["due"]):%a %H:%M}'
        + (' (urgent: office hours do not apply)' if urgent else ''))


def cmd_try(argv):
    j = find(argv[0])
    kind = j.get('kind', 'comment')
    if kind == 'task':
        steps = [task_args(j)]
    elif kind == 'label':
        steps = [label_args(j)]
    elif kind == 'like':
        steps = [like_args(j)]
    else:
        steps = [ac_args(j)] + ([label_args(j)] if j.get('label') else [])
    for a in steps:
        print('$', ' '.join(a[1:]))
        r = subprocess.run(a, cwd=ROOT, capture_output=True, text=True)
        print(r.stdout + r.stderr, end='')
        print(f'(exit {r.returncode}; a rehearsal, nothing was sent)\n')


def cmd_list(_):
    rows = jobs({'queued', 'held', 'failed'})
    if not rows:
        print('nothing waiting')
        return
    for j in rows:
        kind = j.get('kind', 'comment')
        if kind == 'label':
            first = f"(label only) set {j['label']}"
        elif kind == 'task':
            first = f'NEW TASK "{j["title"]}"'[:70]
        elif kind == 'like':
            first = f"(like) comment {j['comment']} on task id {j['task']}"
        else:
            first = (j['_dir'] / 'draft.md').read_text().strip().splitlines()[0][:70]
        when = dt.datetime.fromtimestamp(j['due']).strftime('%a %d/%m %H:%M') if j['status'] == 'queued' else j['status'].upper()
        att = f"  + {', '.join(j['attach'])}" if j['attach'] else ''
        urg = '  URGENT, any hour' if j.get('urgent') else ''
        lab = f"  then label {j['label']}" if j.get('label') and kind == 'comment' else ''
        print(f"{when:<16} {j['as']:<5} p{j['project']} #{j['task']:<4} {j['id']}  {first}{att}{lab}{urg}")
        if j.get('reason'):
            print(f"{'':<16} {j['reason']}")


def cmd_run(_):
    Q.mkdir(parents=True, exist_ok=True)
    lock = open(Q / '.lock', 'w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return
    now = time.time()
    if not open_now(now):
        # launchd runs every 5 minutes, so a slot in the last minutes before 12:00 or 17:00 can be
        # missed. Left alone it would go out in the first minutes of the next opening, which is
        # the pattern the jitter exists to avoid; it moves like any slot outside hours instead.
        moved = False
        for j in jobs({'queued'}):
            if j['due'] <= now and not j.get('urgent'):
                j['due'] = in_day(now)
                save(j)
                moved = True
        # Each moved job drew its own jitter, so two of them could land minutes apart at the next
        # opening (19 Nov 2026: 08:33 and 08:37). The post-time reflow would have spaced the second,
        # but the list, the reminders and the reports read these times; space them now.
        if moved:
            reflow(now)
    due = [j for j in jobs({'queued'}) if j['due'] <= now and (j.get('urgent') or open_now(now))]
    if not due:
        return
    j = due[0]
    if j.get('kind') == 'label':
        return run_label(j, now)
    if j.get('kind') == 'task':
        return run_task(j, now)
    if j.get('kind') == 'like':
        return run_like(j, now)
    r = subprocess.run(ac_args(j) + ['--send', '--hold-if-new-since', str(j['queued_at'])],
                       cwd=ROOT, input='y\n', capture_output=True, text=True)
    out = r.stdout + r.stderr
    (j['_dir'] / f'run-{int(now)}.txt').write_text(out)
    posted = re.search(r'posted comment (\d+) on Task #(\d+) as (.+)', out)
    if r.returncode == 4 and j.get('tries', 0) < 6:
        # The tracker did not answer before anything was sent (ac_comment exits 4 only then), so
        # trying again cannot post twice. Six tries, ten minutes apart, then it fails like any other.
        j['tries'] = j.get('tries', 0) + 1
        j['due'] = int(now) + 600
        save(j)
        log(f'retry {j["id"]}: tracker did not answer (try {j["tries"]} of 6), again at {dt.datetime.fromtimestamp(j["due"]):%H:%M}')
    elif r.returncode == 3:
        j['status'], j['reason'] = 'held', out.strip().splitlines()[-1]
        save(j)
        log(f'held {j["id"]}: {j["reason"]}')
        notify(f'Held, not posted: task #{j["task"]} as {j["as"]}. Someone commented since.')
    elif r.returncode == 0 and posted and 'WRONG ACCOUNT' not in out:
        j['status'], j['posted_at'], j['comment_id'] = 'posted', int(time.time()), int(posted.group(1))
        save(j)
        s = state(); s['last_post'] = j['posted_at']; save_state(s)
        if j.get('label'):
            lr = subprocess.run(label_args(j) + ['--send'], cwd=ROOT, capture_output=True, text=True)
            lout = lr.stdout + lr.stderr
            (j['_dir'] / f'label-{int(now)}.txt').write_text(lout)
            set_line = next((ln for ln in lout.splitlines() if ln.startswith('set ') or 'already so' in ln), None)
            if lr.returncode == 0 and set_line:
                j['labelled'] = j['label']
                save(j)
            else:
                notify(f'Posted, but the label {j["label"]} was NOT set on task #{j["task"]}. See tmp/ac_queue/log.txt.')
        dest = ROOT / 'tmp/archive/messages' / dt.datetime.now().strftime('%Y-%m') / f'queued-{j["id"]}'
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(j['_dir']), dest)
        log(f'posted {j["id"]}: comment {posted.group(1)} on task #{posted.group(2)} as {posted.group(3).strip()}')
        if j.get('label'):
            log(f'labelled {j["id"]}: task #{j["task"]} {j["label"]}' if j.get('labelled')
                else f'LABEL NOT SET {j["id"]}: task #{j["task"]} {j["label"]}; the comment stands, set it with script/ac_label')
        reflow()
    else:
        # Never retried by itself: a half-finished post retried blind is how a comment goes up twice.
        j['status'], j['reason'] = 'failed', (out.strip().splitlines() or ['no output'])[-1]
        save(j)
        log(f'FAILED {j["id"]}: {j["reason"]}')
        notify(f'Comment NOT posted: task #{j["task"]} as {j["as"]}. See tmp/ac_queue.')


def archive(j):
    dest = ROOT / 'tmp/archive/messages' / dt.datetime.now().strftime('%Y-%m') / f'queued-{j["id"]}'
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(j['_dir']), dest)


def run_label(j, now):
    r = subprocess.run(label_args(j) + ['--send'], cwd=ROOT, capture_output=True, text=True)
    out = r.stdout + r.stderr
    (j['_dir'] / f'run-{int(now)}.txt').write_text(out)
    ok = r.returncode == 0 and any(ln.startswith('set ') or 'already so' in ln for ln in out.splitlines())
    if r.returncode == 4 and j.get('tries', 0) < 6:
        j['tries'] = j.get('tries', 0) + 1
        j['due'] = int(now) + 600
        save(j)
        log(f'retry {j["id"]}: tracker did not answer (try {j["tries"]} of 6), again at {dt.datetime.fromtimestamp(j["due"]):%H:%M}')
    elif ok:
        j['status'], j['posted_at'] = 'posted', int(time.time())
        save(j)
        archive(j)
        log(f'labelled {j["id"]}: task #{j["task"]} {j["label"]} as {j["as"]}')
    else:
        j['status'], j['reason'] = 'failed', (out.strip().splitlines() or ['no output'])[-1]
        save(j)
        log(f'FAILED {j["id"]}: {j["reason"]}')
        notify(f'Label NOT set: task #{j["task"]} {j["label"]} as {j["as"]}. See tmp/ac_queue.')


def run_like(j, now):
    r = subprocess.run(like_args(j) + ['--go'], cwd=ROOT, capture_output=True, text=True)
    out = r.stdout + r.stderr
    (j['_dir'] / f'run-{int(now)}.txt').write_text(out)
    back = re.search(r'read back: ThumbsUpReaction by (.+)', out)
    if r.returncode == 0 and back:
        j['status'], j['posted_at'] = 'posted', int(time.time())
        save(j)
        s = state(); s['last_post'] = j['posted_at']; save_state(s)
        archive(j)
        log(f'liked {j["id"]}: comment {j["comment"]} on task id {j["task"]} as {back.group(1).strip()}')
        reflow()
    else:
        # Not retried by itself: ac_like refuses a second like, so a release cannot like twice.
        j['status'], j['reason'] = 'failed', (out.strip().splitlines() or ['no output'])[-1]
        save(j)
        log(f'FAILED {j["id"]}: {j["reason"]}')
        notify(f'Like NOT set: comment {j["comment"]} as {j["as"]}. See tmp/ac_queue.')


def run_task(j, now):
    r = subprocess.run(task_args(j) + ['--go'], cwd=ROOT, capture_output=True, text=True)
    out = r.stdout + r.stderr
    (j['_dir'] / f'run-{int(now)}.txt').write_text(out)
    created = re.search(r'created\s+task #(\d+) \(id (\d+)\) by (.+?),', out)
    if r.returncode == 0 and created and 'WRONG ACCOUNT' not in out:
        j['status'], j['posted_at'], j['created_task'] = 'posted', int(time.time()), int(created.group(1))
        save(j)
        s = state(); s['last_post'] = j['posted_at']; save_state(s)
        archive(j)
        log(f'created {j["id"]}: task #{created.group(1)} "{j["title"]}" as {created.group(3).strip()}')
        reflow()
    else:
        # Not retried by itself, like a comment. ac_task_create refuses a second task with the same
        # title, so a release after a half-finished run cannot create two.
        j['status'], j['reason'] = 'failed', (out.strip().splitlines() or ['no output'])[-1]
        save(j)
        log(f'FAILED {j["id"]}: {j["reason"]}')
        notify(f'Task NOT created: "{j["title"]}" as {j["as"]}. See tmp/ac_queue.')


def find(jid):
    for j in jobs():
        if j['id'] == jid:
            return j
    sys.exit(f'no job {jid}; see script/ac_queue list')


def cmd_cancel(argv):
    j = find(argv[0])
    shutil.rmtree(j['_dir'])
    log(f'cancelled {argv[0]}')


def cmd_release(argv):
    j = find(argv[0])
    # A held reply is released because someone read the new comment and decided it still fits, so
    # the hold check starts again from now. A failed one keeps its own time: a comment written
    # while it waited must still hold it.
    if j['status'] == 'held':
        j['queued_at'] = int(time.time())
    j['status'], j['due'] = 'queued', 0
    j.pop('reason', None)
    j.pop('tries', None)
    save(j)
    reflow()
    j = find(argv[0])
    log(f'released {argv[0]}: goes at {dt.datetime.fromtimestamp(j["due"]):%a %H:%M}')


def cmd_move(argv):
    if len(argv) != 2:
        sys.exit('usage: script/ac_queue move <id> HH:MM|"YYYY-MM-DD HH:MM"')
    lock = open(Q / '.lock', 'w')
    fcntl.flock(lock, fcntl.LOCK_EX)
    j = find(argv[0])
    if j['status'] != 'queued':
        sys.exit(f'{j["id"]} is {j["status"]}, not waiting; release it first')
    old = j['due']
    j['not_before'] = parse_when(argv[1])
    j['due'] = in_day(j['not_before'], j.get('urgent', False))
    save(j)
    reflow()
    j = find(argv[0])
    log(f'moved {j["id"]}: {dt.datetime.fromtimestamp(old):%a %H:%M} -> {dt.datetime.fromtimestamp(j["due"]):%a %H:%M} (asked {argv[1]})')


def cmd_reflow(_):
    Q.mkdir(parents=True, exist_ok=True)
    lock = open(Q / '.lock', 'w')
    fcntl.flock(lock, fcntl.LOCK_EX)    # waits for a run that is posting; that run then skips one turn
    before = {j['id']: j['due'] for j in jobs({'queued'})}
    reflow()
    for j in jobs({'queued'}):
        if j['id'] in before and before[j['id']] != j['due']:
            log(f'moved {j["id"]}: {dt.datetime.fromtimestamp(before[j["id"]]):%a %H:%M} -> {dt.datetime.fromtimestamp(j["due"]):%a %H:%M}')


def cmd_install(_):
    path = os.environ.get('PATH', '/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin')
    PLIST.write_text(f'''<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.luan.spree.ac-queue</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>{path}</string></dict>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/python3</string><string>{ROOT}/script/ac_queue</string><string>run</string></array>
  <key>WorkingDirectory</key><string>{ROOT}</string>
  <key>StartInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>{Q}/launchd.log</string>
  <key>StandardErrorPath</key><string>{Q}/launchd.log</string>
</dict>
</plist>
''')
    Q.mkdir(parents=True, exist_ok=True)
    subprocess.run(['launchctl', 'unload', str(PLIST)], capture_output=True)
    r = subprocess.run(['launchctl', 'load', str(PLIST)], capture_output=True, text=True)
    print(r.stdout + r.stderr or f'loaded {PLIST}: runs every 5 minutes')


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in ('add', 'task', 'label', 'like', 'try', 'move', 'list', 'run', 'cancel', 'release', 'reflow', 'install'):
        sys.exit(__doc__)
    globals()['cmd_' + sys.argv[1]](sys.argv[2:])


if __name__ == '__main__':
    main()
