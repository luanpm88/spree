<%# His welcome copy when he has written it, our own wording when he has not. See the
    HTML twin for why his section IS this email. %>
<% if @copy_scope.present? %><%= render 'approval_outcome' %><% else %>
<%= Spree.t('customer_mailer.welcome_email.heading', store: @current_store.name) %>

<%= Spree.t('customer_mailer.welcome_email.greeting', name: @user.first_name.presence || @user.email) %>

<%= Spree.t('customer_mailer.welcome_email.body', store: @current_store.name) %>
<% if @reset_url.present? -%>

<%= Spree.t('customer_mailer.welcome_email.fallback') %>
<%= @reset_url %>

<%= Spree.t('customer_mailer.welcome_email.expiry') %>
<% end -%>

<%= Spree.t(:owner_name, scope: [:user_emails, :common]) %>
<%= Spree.t(:owner_title, scope: [:user_emails, :common]) %>
<% slogan = Spree.t(:slogan, scope: [:user_emails, :common], default: '') -%>
<% if slogan.present? -%>
<%= slogan %>
<% end -%>
<% end %>
