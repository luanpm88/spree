<%# His welcome copy when he has written it, our own markup when he has not.
    @copy_scope is set by the mailer and is nil on a checkout without his file.

    His section IS this email: heading "Your Account Is Awaiting Final Approval", and a
    bullet promising a second email once approved. So it renders through the same partial
    as the other three outcome emails, which is also what keeps his file the single source
    of the shape. %>
<% if @copy_scope.present? %>
  <%= render 'approval_outcome' %>
<% else %>
  <%= render layout: 'spree/shared/mailer_hero' do %>
    <h1><%= Spree.t('customer_mailer.welcome_email.heading', store: @current_store.name) %></h1>

    <p class="greeting">
      <%= Spree.t('customer_mailer.welcome_email.greeting',
                  name: @user.first_name.presence || @user.email) %>
    </p>

    <p><%= Spree.t('customer_mailer.welcome_email.body', store: @current_store.name) %></p>

    <% if @reset_url.present? %>
      <%= render 'spree/shared/mailer_button',
                 url: @reset_url,
                 label: Spree.t('customer_mailer.welcome_email.cta') %>

      <p class="sub"><%= Spree.t('customer_mailer.welcome_email.expiry') %></p>

      <%# Every mail client eventually eats a button, and this link is the only way in.
          The raw URL is the difference between a customer who signs in and a support
          message. %>
      <p class="sub">
        <%= Spree.t('customer_mailer.welcome_email.fallback') %>
        <br>
        <span style="word-break: break-all;"><%= @reset_url %></span>
      </p>
    <% end %>
  <% end %>
<% end %>
