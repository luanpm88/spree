<%#
  Every email this shop sends, and what one looks like.

  ── the layout is the themes screen's ──────────────────────────────────────

  A list on the left, the thing itself on the right, the same device toggle and
  the same full screen. Somebody who has used that screen already knows how this
  one works, which is worth more than any originality here.

  The device toggle earns its place more here than there: over half of
  transactional email is opened on a phone, and an email that looks right at
  1200px and breaks at 390px is the ordinary way for one to be wrong.

  ── but the parts are the admin's own ──────────────────────────────────────

  card, badge, btn, and icon() for every glyph. The first draft of this screen
  invented `email-row__badge`, `email-preview__tool` and inline <svg> for things
  the admin already ships, and printed its own <h1> under the header the layout
  had already drawn. The only classes defined here are the ones with no
  equivalent: the two-column frame and the scaled preview stage.

  ── the frame is a SANDBOXED iframe, and it has to be ──────────────────────

  An email carries its own <style>, its own table layout and, for Outlook, its
  own conditional comments. Inlined into this page the admin's stylesheet would
  reach into it and its own would reach out.

  The sandbox is the more serious half. This app has no CSP —
  config/initializers/content_security_policy.rb is commented out end to end —
  and these bodies include templates ported off the client's live site, with
  merchant-authored HTML to come. Without `allow-same-origin` the document is an
  opaque origin: it cannot read this page, and it cannot touch the admin session.
%>
<% content_for :page_title do %>
  <%= Spree.t('admin.emails.title') %>
<% end %>

<%# :page_actions, not :page_subtitle. _content_header SETS :page_subtitle for a
    record but never yields it, so anything put there is silently dropped —
    which is what the first screenshot of this screen showed. %>
<% content_for :page_actions do %>
  <span class="badge badge-light"><%= Spree.t('admin.emails.count', count: @entries.size) %></span>
<% end %>

<% if @entries.empty? %>
  <%= render 'spree/admin/shared/no_resource_found', resource_name: Spree.t('admin.emails.title') %>
<% else %>
  <div class="email-editor" id="email-editor"
       data-preview-base="<%= spree.admin_emails_path %>">

    <%# ── the list ────────────────────────────────────────────────────────── %>
    <div class="card email-list">
      <% @entries.group_by(&:group).sort.each do |group, rows| %>
        <div class="dropdown-header"><%= group %></div>
        <% rows.each do |entry| %>
          <% status, note = email_state(entry) %>
          <a class="email-row <%= 'is-current' if @selected && @selected.key == entry.key %>"
             href="<%= spree.admin_email_path(entry.id) %>"
             data-email-row="<%= entry.id %>"
             data-email-status="<%= status %>">
            <span class="email-row__name"><%= entry.name %></span>
            <%= email_status_badge(status) %>
            <%# The reason sits under the name, not in a tooltip. A merchant
                should not have to hover to find out why a row is grey. %>
            <% if note.present? %>
              <span class="email-row__note"><%= note %></span>
            <% end %>
            <span class="email-row__meta">
              <%= entry.text? ? Spree.t('admin.emails.html_and_text') : Spree.t('admin.emails.html_only') %>
              &middot;
              <%= entry.source_label %>
            </span>
          </a>
        <% end %>
      <% end %>
    </div>

    <%# ── the email itself ────────────────────────────────────────────────── %>
    <div class="card email-preview">
      <div class="email-preview__bar">
        <span class="email-preview__dot"></span>
        <span class="email-preview__where" id="email-where"><%= @selected&.key %></span>

        <span class="email-preview__tools">
          <button type="button" class="btn btn-light btn-sm is-on" data-email-part="html">
            <%= Spree.t('admin.emails.formats.html') %>
          </button>
          <button type="button" class="btn btn-light btn-sm" data-email-part="text">
            <%= Spree.t('admin.emails.formats.text') %>
          </button>
          <span class="email-preview__sep"></span>
          <button type="button" class="btn btn-light btn-sm is-on" data-email-device="desktop"
                  title="<%= Spree.t('admin.emails.desktop') %>"><%= icon 'device-desktop', class: 'mr-0' %></button>
          <button type="button" class="btn btn-light btn-sm" data-email-device="mobile"
                  title="<%= Spree.t('admin.emails.mobile') %>"><%= icon 'device-mobile', class: 'mr-0' %></button>
          <button type="button" class="btn btn-light btn-sm" id="email-expand"
                  title="<%= Spree.t('admin.emails.expand') %>"><%= icon 'arrows-maximize', class: 'mr-0' %></button>
        </span>
      </div>

      <%# The envelope, above the body, because a merchant checking an email is
          usually checking the subject line as much as the design. %>
      <div class="email-preview__head" id="email-head" hidden>
        <div>
          <span class="email-preview__label"><%= Spree.t('admin.emails.subject') %></span>
          <strong id="email-subject"></strong>
        </div>
        <div>
          <span class="email-preview__label"><%= Spree.t('admin.emails.sends_from') %></span>
          <span id="email-from"></span>
        </div>
        <%# Both of these print straight to the customer and I18n raises on
            neither, so they are shown here rather than left for somebody to
            grep the body for. Hidden when there is nothing to say. %>
        <div id="email-warnings" class="email-preview__warnings" hidden></div>
      </div>

      <div class="email-preview__stage" id="email-stage">
        <iframe class="email-preview__frame" id="email-frame" sandbox
                title="<%= Spree.t('admin.emails.title') %>"></iframe>
        <div class="email-preview__veil" id="email-veil"><span class="email-preview__spinner"></span></div>
      </div>

      <div class="email-preview__foot"><%= Spree.t('admin.emails.built_now') %></div>
    </div>
  </div>
<% end %>

<%= render 'spree/admin/emails/script' %>
