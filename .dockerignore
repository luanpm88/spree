# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
.git/
.gitignore

# Ignore bundler config.
.bundle

# Ignore all environment files.
.env*

# Ignore all default key files.
config/master.key
config/credentials/*.key

# Ignore all logfiles and tempfiles.
log/*
tmp/*
!log/.keep
!tmp/.keep

# Ignore pidfiles, but keep the directory.
tmp/pids/*
!tmp/pids/.keep

# Ignore storage (uploaded files on local disk).
storage/*
!storage/.keep

# Ignore assets.
/app/assets/builds/*
!app/assets/builds/.keep

# Ignore CI and Docs
.github
.claude

# Docs tooling — Playwright/markdown-it are only used to build the PDF guide
# on a workstation. 21MB that must never enter the image build context.
node_modules
docs/screenshots
docs/USER_GUIDE.pdf
docs/.user_guide.build.html

# The storefront builds from its own context (./app/storefront, its own
# .dockerignore) and the Rails image needs none of it. Left in, the context was
# 1.23 GB on a worktree with the storefront's node_modules installed (29 Oct),
# and the storefront's source rode into the Rails image.
storefront
# The dashboard app's install and build output: the image's dashboard stage
# installs from the lockfile and builds its own.
apps/*/node_modules
apps/*/dist
apps/*/.tanstack
apps/*/.pnpm-store
.build
